ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")


def strip_ansi(text: str) -> str:
    return ANSI_RE.sub("", text or "")


def detect_network_summary() -> str:
    """Определяет состояние Кабеля (Ethernet) и Wi-Fi для отображения в шапке."""
    wired = []
    wifi = []
    try:
        out = subprocess.check_output(["ip", "-o", "-4", "addr", "show", "up"], text=True, timeout=1.5)
        for line in out.splitlines():
            parts = line.split()
            if len(parts) < 4:
                continue
            ifname = parts[1].split(":")[0]
            if ifname == "lo" or ifname.startswith(("docker", "br-", "veth", "virbr", "tun", "tap")):
                continue
            cidr = parts[3]
            is_wireless = os.path.exists(f"/sys/class/net/{ifname}/wireless") or ifname.startswith(("wl", "wlan", "wifi"))
            if is_wireless:
                wifi.append(f"{ifname} ({cidr})")
            else:
                wired.append(f"{ifname} ({cidr})")
    except Exception:
        pass

    if not wired:
        try:
            for ifname in os.listdir("/sys/class/net"):
                if ifname == "lo" or ifname.startswith(("wl", "wlan", "docker", "br-", "veth", "virbr")):
                    continue
                carrier_path = f"/sys/class/net/{ifname}/carrier"
                if os.path.exists(carrier_path):
                    with open(carrier_path, "r") as f:
                        if f.read().strip() == "1":
                            wired.append(f"{ifname} (L2 без IP)")
        except Exception:
            pass

    w_str = f"Кабель: {', '.join(wired)}" if wired else "Кабель: не подключен"
    wf_str = f"Wi-Fi: {', '.join(wifi)}" if wifi else "Wi-Fi: откл."
    return f"● {w_str}   |   {wf_str}   (Маршрутизация /32 активна)"


