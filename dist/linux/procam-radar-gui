    def action_set_ip_dialog(self):
        old_ip = self.ip_entry.get().strip()
        mac = self.mac_entry.get().strip()
        if not old_ip:
            return
        new_ip = simpledialog.askstring("Изменить IP-адрес", f"Текущий IP: {old_ip}\nВведите новый IP-адрес:", parent=self)
        if not new_ip:
            return
        creds = simpledialog.askstring(
            "Авторизация камеры",
            "Логин:пароль (оставьте пустым для авто-подбора):",
            initialvalue="",
            parent=self,
        )
        args = ["set-ip", old_ip, new_ip.strip()]
        if creds and ":" in creds:
            u, p = creds.split(":", 1)
            args.extend([u, p])
        if mac:
            args.extend(["--mac", mac])
        self._run_yeee_async(args, f"Смена IP {old_ip} → {new_ip.strip()}")


