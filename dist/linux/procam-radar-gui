            self.net_lbl.configure(text=detect_network_summary())
        except Exception:
            pass
        self.after(6000, self._refresh_net_status)

    def append_log(self, msg: str):
        clean_msg = strip_ansi(msg)
        self.log_text.insert(tk.END, clean_msg)
        self.log_text.see(tk.END)

    def _set_busy(self, busy: bool, label: str = ""):
        self.running_task = busy
        if busy:
            self.status_lbl.configure(text=f"⏳ {label}...", fg="#059669")
        else:
            self.status_lbl.configure(text="● Готов к работе", fg="#09090B")

    def _on_tree_select(self, _event):
        sel = self.tree.selection()
        if not sel:
            return
        vals = self.tree.item(sel[0], "values")
        if len(vals) >= 4:
            self.ip_entry.delete(0, tk.END)
            self.ip_entry.insert(0, vals[2])
            self.mac_entry.delete(0, tk.END)
            self.mac_entry.insert(0, vals[3])

    def _load_cached_cameras(self):
        for item in self.tree.get_children():
            self.tree.delete(item)
        if not os.path.exists(LAST_SCAN_CACHE):
            return
        try:
            with open(LAST_SCAN_CACHE, "r", encoding="utf-8") as f:
                data = json.load(f)
            self.cameras = data.get("cameras", [])
            for cam in self.cameras:
                if cam.get("conflict"):
                    zone = "Конфликт IP"
                elif cam.get("is_local_subnet", True):
                    zone = "Своя сеть"
                else:
                    zone = "Чужая подсеть"
                iface_s = cam.get("iface") or data.get("interface") or "auto"
                ports_s = ", ".join(str(p) for p in cam.get("open_ports", [])) or "L2"
                sub_s = cam.get("subnet_info", {}).get("status", "-")
                self.tree.insert(
                    "",
                    tk.END,
                    values=(
                        zone,
                        iface_s,
                        cam.get("ip", "-"),
                        cam.get("mac_upper") or cam.get("mac", "-").upper(),
                        cam.get("vendor_resolved") or cam.get("vendor", "-"),
                        cam.get("model", "-"),
                        cam.get("serial", "-"),
                        ports_s,
                        sub_s,
                    ),
                )
        except Exception as exc:
            self.append_log(f"Ошибка чтения кэша: {exc}\n")

    def _run_yeee_async(self, args: list, task_title: str, reload_table: bool = False, on_done=None):
        if self.running_task:
            messagebox.showinfo("Выполняется", "Дождитесь завершения текущей операции.")
            return
        self._set_busy(True, task_title)
        cmd = [YEEE_BIN] + args
        self.append_log(f"\n━━━ {task_title} ━━━\n")

        def worker():
            try:
                proc = subprocess.Popen(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1,
                )
                for line in proc.stdout:
                    self.after(0, self.append_log, line)
                proc.wait()
            except Exception as exc:
                self.after(0, self.append_log, f"Ошибка: {exc}\n")
            finally:
                def finish():
                    self._set_busy(False)
                    if reload_table:
                        self._load_cached_cameras()
                    if on_done:
                        on_done()
                self.after(0, finish)

        threading.Thread(target=worker, daemon=True).start()

