def run_cmd(cmd: list) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)


def get_carrier(iface: str) -> bool:
    """Читает физический статус линка /sys/class/net/<iface>/carrier."""
    carrier_path = f"/sys/class/net/{iface}/carrier"
    try:
        with open(carrier_path, "r") as f:
            return f.read().strip() == "1"
    except OSError:
        return False


def ensure_iface_up(iface: str) -> None:
    """Поднимает интерфейс административно (ip link set <iface> up) для детекта carrier."""
    try:
        flags_path = f"/sys/class/net/{iface}/flags"
        if os.path.exists(flags_path):
            with open(flags_path, "r") as f:
                flags = int(f.read().strip(), 16)
            if not (flags & 0x1):  # IFF_UP
                run_cmd(["ip", "link", "set", iface, "up"])
                time.sleep(0.3)
    except Exception:
        pass


def get_iface_mac(iface: str) -> str:
    """Возвращает MAC-адрес интерфейса."""
    try:
        with open(f"/sys/class/net/{iface}/address", "r") as f:
            return f.read().strip().lower()
    except OSError:
        return "00:00:00:00:00:00"


def get_iface_ipv4_list(iface: str) -> list:
    """
    Возвращает список словарей: [{'ip': '192.168.0.10', 'prefix': 24, 'cidr': '192.168.0.10/24', 'label': 'wlp4s0'}]
    Использует JSON-вывод iproute2 (`ip -j -4 addr show dev <iface>`).
    """
    res = run_cmd(["ip", "-j", "-4", "addr", "show", "dev", iface])
    addrs = []
    if res.returncode == 0 and res.stdout.strip():
        try:
            data = json.loads(res.stdout)
            for iface_obj in data:
                for info in iface_obj.get("addr_info", []):
                    if info.get("family") == "inet" and "local" in info and "prefixlen" in info:
                        ip_str = info["local"]
                        prefix = int(info["prefixlen"])
                        label = info.get("label", iface)
                        addrs.append({
                            "ip": ip_str,
                            "prefix": prefix,
                            "cidr": f"{ip_str}/{prefix}",
                            "label": label,
                        })
            return addrs
        except Exception:
            pass
    return addrs


def get_all_local_macs_and_ips() -> tuple:
    """Собирает все собственные MAC и IPv4 адреса ноутбука, чтобы не ловить свои же пакеты."""
    local_macs = set()
    local_ips = {"127.0.0.1", "0.0.0.0"}
    try:
        for iface in os.listdir("/sys/class/net"):
            mac = get_iface_mac(iface)
            if mac and mac != "00:00:00:00:00:00":
                local_macs.add(mac)
            for item in get_iface_ipv4_list(iface):
                local_ips.add(item["ip"])
    except Exception:
        pass
    return local_macs, local_ips


def discover_interfaces() -> tuple:
    """
    Автовыбор сетевого интерфейса:
    - Приоритет физическому проводному интерфейсу (eth*, enp*, eno*, ens*, enx*).
    - Если проводной кабель не подключен (carrier == 0), используется активный Wi-Fi (wlan*, wlp*).
    Возвращает: (selected_iface, is_wired, all_wired_ifaces, all_wifi_ifaces)
    """
    try:
        net_ifaces = sorted(os.listdir("/sys/class/net"))
    except OSError:
        net_ifaces = []

    wired_ifaces = []
    wifi_ifaces = []

    for iface in net_ifaces:
        if iface == "lo" or iface.startswith(("docker", "veth", "br-", "virbr", "tailscale", "tun", "tap", "wg")):
            continue
        is_wireless = os.path.isdir(f"/sys/class/net/{iface}/wireless") or os.path.isdir(f"/sys/class/net/{iface}/phy80211")
        if iface.startswith(("wlan", "wlp", "wlx")) or is_wireless:
            wifi_ifaces.append(iface)
        elif iface.startswith(("eth", "enp", "eno", "ens", "enx")):
            wired_ifaces.append(iface)

    # Проверяем физические проводные интерфейсы
    for w_iface in wired_ifaces:
        ensure_iface_up(w_iface)
        if get_carrier(w_iface):
            return w_iface, True, wired_ifaces, wifi_ifaces

    # Если кабель не подключен — ищем активный Wi-Fi интерфейс
    for wf_iface in wifi_ifaces:
        ensure_iface_up(wf_iface)
        if get_carrier(wf_iface):
            return wf_iface, False, wired_ifaces, wifi_ifaces

    # Если Wi-Fi не подключен, но есть проводной интерфейс — выбираем проводной (ожидание линка)
    if wired_ifaces:
        return wired_ifaces[0], True, wired_ifaces, wifi_ifaces
    if wifi_ifaces:
        return wifi_ifaces[0], False, wired_ifaces, wifi_ifaces

    raise RuntimeError("Не найдено ни одного подходящего проводного (eth*/enp*/eno*) или Wi-Fi (wlan*/wlp*) интерфейса.")


