def run_discovery(fast_mode: bool = False) -> int:
    wait_seconds = 5 if fast_mode else 30
    mode_title = "FAST SCAN (5 сек)" if fast_mode else "ИНТЕРАКТИВНЫЙ РЕЖИМ «ОТКЛЮЧИ -> ПОДКЛЮЧИ» (30 сек)"

    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}  YEEE v2.0 — Сканер IP-камер в чужих подсетях | {mode_title}{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")

    try:
        iface, is_wired, wired_ifaces, wifi_ifaces = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    conn_type = "Проводной Ethernet (прямой линк)" if is_wired else "Wi-Fi (через роутер/коммутатор)"
    carrier_state = "ПОДКЛЮЧЕН (carrier=1)" if get_carrier(iface) else "ОЖИДАНИЕ КАБЕЛЯ (carrier=0)"
    print(f"{C.BOLD}[ИНТЕРФЕЙС]{C.RESET} Выбран: {C.GREEN}{C.BOLD}{iface}{C.RESET} [{conn_type}] | Статус: {carrier_state}")

    local_macs, local_ips = get_all_local_macs_and_ips()
    probe_src_ips = set(local_ips)

    # ЭТАП 1: Калибровка сети роутера / Baseline
    baseline_macs, baseline_ips = calibrate_baseline(iface, local_macs, local_ips)

    # ЭТАП 2: Интерактивный режим «Отключи -> Подключи»
    if not fast_mode:
        print(f"\n{C.YELLOW}{C.BOLD}╔══════════════════════════════════════════════════════════════════╗{C.RESET}")
        print(f"{C.YELLOW}{C.BOLD}║  ШАГ 1: Отключите патчкорд (или питание PoE) камеры от           ║{C.RESET}")
        print(f"{C.YELLOW}{C.BOLD}║         роутера/свитча/ноутбука на 3 секунды.                    ║{C.RESET}")
        print(f"{C.YELLOW}{C.BOLD}║  ШАГ 2: Подключите патчкорд камеры обратно. Ожидание пакета      ║{C.RESET}")
        print(f"{C.YELLOW}{C.BOLD}║         инициализации камеры (до 30 секунд)...                   ║{C.RESET}")
        print(f"{C.YELLOW}{C.BOLD}╚══════════════════════════════════════════════════════════════════╝{C.RESET}")
    else:
        print(f"\n{C.YELLOW}{C.BOLD}[ЭТАП 2/5]{C.RESET} Быстрый режим (fast): сканирование без ожидания переподключения ({wait_seconds} сек)...")

    # ЭТАП 3: Активная L2-провокация + Сниффинг дельты
    print(f"\n{C.BLUE}{C.BOLD}[ЭТАП 3/5] Активная L2-провокация (ONVIF + SADP) и перехват ARP/UDP дельты...{C.RESET}")

    discovered = {}
    lock = threading.Lock()
    stop_event = threading.Event()
    active_ifaces = [iface]
    for w_iface in wired_ifaces:
        if w_iface not in active_ifaces:
            active_ifaces.append(w_iface)

    def register_detection(src_mac: str, ip_candidate: str, pkt_iface: str, reason: str, meta: dict = None):
        meta = meta or {}
        src_mac = src_mac.lower()
        if src_mac in local_macs or src_mac in ("00:00:00:00:00:00", "ff:ff:ff:ff:ff:ff"):
            return
        if ip_candidate in probe_src_ips or ip_candidate in ("255.255.255.255", "239.255.255.250", "239.255.255.251"):
            return
        if ip_candidate and ip_candidate.startswith(("127.", "224.", "239.")):
            return

        cam_vendor = meta.get("vendor") or get_camera_vendor(src_mac)
        if src_mac in baseline_macs and not cam_vendor:
            return

        with lock:
            prev = discovered.get(src_mac)
            if not prev:
                discovered[src_mac] = {
                    "mac": src_mac,
                    "ip": ip_candidate or "0.0.0.0",
                    "vendor": cam_vendor,
                    "model": meta.get("model", ""),
                    "serial": meta.get("serial", ""),
                    "firmware": meta.get("firmware", ""),
                    "iface": pkt_iface,
                    "reason": reason,
                }
                if ip_candidate and ip_candidate != "0.0.0.0":
                    v_label = f" [{cam_vendor}]" if cam_vendor else ""
                    m_label = f" ({meta['model']})" if meta.get("model") else ""
                    print(
                        f"\n  {C.GREEN}{C.BOLD}⚡ [ПЕРЕХВАТ!]{C.RESET} Обнаружено устройство: "
                        f"IP={C.CYAN}{C.BOLD}{ip_candidate}{C.RESET} | MAC={C.YELLOW}{src_mac.upper()}{C.RESET}"
                        f"{C.MAGENTA}{v_label}{m_label}{C.RESET} ({reason})"
                    )
                    stop_event.set()
                else:
                    print(
                        f"\n  {C.YELLOW}⚡ [GARP 0.0.0.0]{C.RESET} Зафиксирован пакет инициализации от "
                        f"MAC={C.YELLOW}{src_mac.upper()}{C.RESET} ({reason}). Ожидание IPv4..."
                    )
            else:
                for k in ("model", "serial", "firmware"):
                    if meta.get(k) and not prev.get(k):
                        prev[k] = meta[k]
                if cam_vendor and not prev.get("vendor"):
                    prev["vendor"] = cam_vendor

                if (prev["ip"] == "0.0.0.0" or not prev["ip"]) and ip_candidate and ip_candidate != "0.0.0.0":
                    prev["ip"] = ip_candidate
                    v_label = f" [{prev['vendor']}]" if prev.get("vendor") else ""
                    print(
                        f"\n  {C.GREEN}{C.BOLD}⚡ [ПЕРЕХВАТ IP!]{C.RESET} Уточнен адрес устройства: "
                        f"IP={C.CYAN}{C.BOLD}{ip_candidate}{C.RESET} | MAC={C.YELLOW}{src_mac.upper()}{C.RESET}"
                        f"{C.MAGENTA}{v_label}{C.RESET} ({reason})"
                    )
                    stop_event.set()

    def pkt_callback(pkt):
        if not pkt.haslayer(Ether):
            return
        src_mac = pkt[Ether].src.lower()
        if src_mac in local_macs or src_mac == "ff:ff:ff:ff:ff:ff":
            return

        pkt_iface = getattr(pkt, "sniffed_on", iface) or iface

        # 1. Проверка ARP-пакетов
        if pkt.haslayer(ARP):
            psrc = pkt[ARP].psrc
            pdst = pkt[ARP].pdst
            op = pkt[ARP].op
            if psrc == "0.0.0.0":
                candidate = pdst if (pdst and pdst != "0.0.0.0" and pdst not in probe_src_ips) else "0.0.0.0"
                register_detection(src_mac, candidate, pkt_iface, f"Gratuitous ARP Probe (0.0.0.0 -> {pdst})")
            else:
                reason = f"ARP {'Request (who-has ' + pdst + ')' if op == 1 else 'Reply'}"
                register_detection(src_mac, psrc, pkt_iface, reason)
            return

        # 2. Проверка IP / UDP пакетов (SADP 37020, ONVIF 3702, Dahua 37810)
        if pkt.haslayer(IP):
            src_ip = pkt[IP].src
            parsed_meta = {}

            if pkt.haslayer(UDP) and pkt.haslayer(Raw):
                sport = pkt[UDP].sport
                dport = pkt[UDP].dport
                raw_bytes = bytes(pkt[Raw].load)
                if sport in (3702, 37020, 37810) or dport in (3702, 37020, 37810):
                    parsed_meta = parse_xml_discovery_payload(raw_bytes)

            xml_ip = parsed_meta.get("ip")
            vendor_hint = parsed_meta.get("vendor", "")
            effective_ip = xml_ip if (xml_ip and xml_ip != "0.0.0.0") else src_ip

            if vendor_hint or is_camera_mac(src_mac) or (src_mac not in baseline_macs and effective_ip not in baseline_ips and effective_ip != "0.0.0.0"):
                reason = f"UDP/L2 Response ({vendor_hint or 'IP Packet'})"
                register_detection(src_mac, effective_ip, pkt_iface, reason, parsed_meta)

    def prover_and_carrier_worker():
        last_carrier = {w: get_carrier(w) for w in wired_ifaces}
        next_probe_time = 0.0
        while not stop_event.is_set():
            now = time.time()
            for w_iface in wired_ifaces:
                cur_c = get_carrier(w_iface)
                if cur_c != last_carrier.get(w_iface):
                    last_carrier[w_iface] = cur_c
                    if cur_c:
                        print(f"\n  {C.GREEN}{C.BOLD}[LINK UP]{C.RESET} Физический линк на {w_iface} активен (/sys/class/net/{w_iface}/carrier = 1)!")
                        send_l2_provocations(w_iface, probe_src_ips)
                    else:
                        print(f"\n  {C.YELLOW}[LINK DOWN]{C.RESET} Кабель отключен на {w_iface} (/sys/class/net/{w_iface}/carrier = 0).")

            if now >= next_probe_time:
                for target_iface in active_ifaces:
                    send_l2_provocations(target_iface, probe_src_ips)
                next_probe_time = now + 2.0

            stop_event.wait(0.25)

    worker_thread = threading.Thread(target=prover_and_carrier_worker, daemon=True)
    worker_thread.start()

    start_ts = time.time()
    try:
        while not stop_event.is_set():
            elapsed = time.time() - start_ts
            remaining = wait_seconds - elapsed
            if remaining <= 0:
                break
            sys.stdout.write(
                f"\r  {C.CYAN}⏳ Ожидание пакета камеры и отправка ONVIF/SADP L2-провокаций... "
                f"Осталось: {int(remaining):02d} сек (Ctrl+C для завершения){C.RESET}   "
            )
            sys.stdout.flush()
            sniff(
                iface=active_ifaces,
                timeout=min(1.0, remaining),
                store=False,
                prn=pkt_callback,
                stop_filter=lambda _: stop_event.is_set(),
            )
        if stop_event.is_set():
            sniff(iface=active_ifaces, timeout=0.7, store=False, prn=pkt_callback)
    except KeyboardInterrupt:
        print(f"\n  {C.YELLOW}[!] Ожидание прервано пользователем (Ctrl+C). Переход к обработке пойманных устройств...{C.RESET}")
    finally:
        stop_event.set()
        sys.stdout.write("\n")

    if not discovered:
        save_last_scan_cache(iface, "fast" if fast_mode else "interactive", [])
        print(f"\n{C.YELLOW}{C.BOLD}[РЕЗУЛЬТАТ]{C.RESET} Новых IP-камер или узлов за время окна ожидания не обнаружено.")
        print(f"{C.DIM}Совет: убедитесь, что питание камеры включено, и повторите запуск `yeee`.{C.RESET}")
        return 0

    # ЭТАП 4 и ЭТАП 5: Инъекция подсети + проверка портов + карточка
    print(f"\n{C.BLUE}{C.BOLD}[ЭТАП 4/5] Инъекция временной подсети и [ЭТАП 5/5] Проверка TCP-портов...{C.RESET}")
    idx = 1
    results_list = []
    for mac, cam in discovered.items():
        cam_ip = cam["ip"]
        cam_iface = cam.get("iface") or iface
        if cam_ip and cam_ip != "0.0.0.0":
            subnet_info = inject_subnet_alias(cam_iface, cam_ip)
            cam["subnet_info"] = subnet_info
            time.sleep(0.2)
            cam["open_ports"] = scan_camera_ports(cam_ip)
        else:
            cam["subnet_info"] = {
                "injected": False,
                "status": "Камера прислала только 0.0.0.0 (IP не назначен)",
                "alias_ip": None,
            }
            cam["open_ports"] = []

        print_camera_card(idx, cam)
        results_list.append(cam)
        idx += 1

    save_last_scan_cache(iface, "fast" if fast_mode else "interactive", results_list)
    print(f"\n{C.DIM}Для экспорта отчета выполните: {C.BOLD}yeee dump{C.RESET}{C.DIM} | Для очистки подсетей: {C.BOLD}yeee clean{C.RESET}")
    return 0


# ==============================================================================
# КОМАНДА CONFLICT: АКТИВНЫЙ ARP-СКАНЕР ДУБЛИКАТОВ IP (agent_04_diag)
# ==============================================================================
def run_conflict_scan() -> int:
    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}  YEEE CONFLICT — Активный ARP-детектор конфликтов IP-адресов{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")

    try:
        iface, is_wired, _, _ = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    src_mac = get_iface_mac(iface)
    local_macs, _ = get_all_local_macs_and_ips()
    ipv4_list = get_iface_ipv4_list(iface)

    subnets_to_scan = []
    seen_nets = set()
    for item in ipv4_list:
        ip_str = item["ip"]
        octets = ip_str.split(".")
        net_24 = f"{octets[0]}.{octets[1]}.{octets[2]}.0/24"
        if net_24 not in seen_nets:
            seen_nets.add(net_24)
            subnets_to_scan.append((ip_str, net_24))

    if not subnets_to_scan:
        subnets_to_scan.append(("192.168.1.250", "192.168.1.0/24"))

    print(f"{C.BOLD}[ИНТЕРФЕЙС]{C.RESET} {C.GREEN}{iface}{C.RESET} ({src_mac.upper()})")
    print(f"{C.BOLD}[ПОДСЕТИ]{C.RESET}   {', '.join(n for _, n in subnets_to_scan)}")

    ip_to_macs = {}  # ip -> set(mac)
    lock = threading.Lock()

    # Предзаполняем текущими записями из /proc/net/arp на данном интерфейсе
    try:
        with open("/proc/net/arp", "r") as f:
            for line in f.read().splitlines()[1:]:
                parts = line.split()
                if len(parts) >= 6:
                    ip_a, _, flags, mac_a, _, dev = parts[:6]
                    mac_a = mac_a.lower()
                    if dev == iface and flags != "0x0" and mac_a != "00:00:00:00:00:00":
                        ip_to_macs.setdefault(ip_a, set()).add(mac_a)
    except Exception:
        pass

    def arp_pkt_handler(pkt):
        if not pkt.haslayer(Ether) or not pkt.haslayer(ARP):
            return
        s_mac = pkt[Ether].src.lower()
        psrc = pkt[ARP].psrc
        if s_mac in local_macs or s_mac in ("00:00:00:00:00:00", "ff:ff:ff:ff:ff:ff"):
            return
        if not psrc or psrc == "0.0.0.0":
            return
        with lock:
            ip_to_macs.setdefault(psrc, set()).add(s_mac)

    frames = []
    for src_ip, net_cidr in subnets_to_scan:
        net_obj = ipaddress.IPv4Network(net_cidr, strict=False)
        for host_ip in net_obj.hosts():
            h_str = str(host_ip)
            if h_str == src_ip:
                continue
            frames.append(
                Ether(src=src_mac, dst="ff:ff:ff:ff:ff:ff")
                / ARP(op=1, hwsrc=src_mac, psrc=src_ip, hwdst="00:00:00:00:00:00", pdst=h_str)
            )

    def send_arp_sweep():
        time.sleep(0.2)
        try:
            sendp(frames, iface=iface, verbose=False)
            time.sleep(1.0)
            sendp(frames, iface=iface, verbose=False)
        except Exception:
            pass

    print(f"{C.BLUE}[СКАНИРОВАНИЕ]{C.RESET} Отправка широковещательных ARP-запросов ({len(frames)} адресов) и сбор ответов (3 сек)...")
    t = threading.Thread(target=send_arp_sweep, daemon=True)
    t.start()
    try:
        sniff(iface=iface, filter="arp", timeout=3.0, store=False, prn=arp_pkt_handler)
    except Exception:
        pass

    conflicts = {ip: macs for ip, macs in ip_to_macs.items() if len(macs) > 1}
    print(f"\n{C.BOLD}[СВОДКА]{C.RESET} Откликнулось уникальных IP-узлов: {len(ip_to_macs)}")

    if conflicts:
        for ip, macs in sorted(conflicts.items()):
            print(f"\n{C.RED}{C.BOLD}🚨 [CRITICAL] IP CONFLICT DETECTED на адресе {ip}!{C.RESET}")
            for m in sorted(macs):
                vendor = get_camera_vendor(m) or "Неизвестный вендор / Сетевой узел"
                print(f"   {C.RED}➔ MAC: {C.BOLD}{m.upper()}{C.RESET} ({C.YELLOW}{vendor}{C.RESET})")
    else:
        for ip, macs in sorted(ip_to_macs.items()):
            m = next(iter(macs))
            vendor = get_camera_vendor(m) or "Сетевой узел"
