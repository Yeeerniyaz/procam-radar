    try:
        iface, _, _, _ = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    sub_info = inject_subnet_alias(iface, target_ip)
    print(f"{C.BOLD}[ЦЕЛЬ]{C.RESET}      {C.CYAN}{C.BOLD}{target_ip}{C.RESET} через {C.GREEN}{iface}{C.RESET} ({sub_info.get('status')})")

    # 1. Тест стандартными пакетами 64 байта (56 байт payload + 8 байт ICMP заголовок)
    print(f"\n{C.BLUE}[ТЕСТ 1/2]{C.RESET} Отправка 100 стандартных ICMP-пакетов (64 байта: `ping -c 100 -i 0.01 -s 56 -W 1 {target_ip}`)...")
    res_small = run_cmd(["ping", "-c", "100", "-i", "0.01", "-s", "56", "-W", "1", target_ip])
    stats_small = parse_ping_output(res_small.stdout)
    print(
        f"  ➔ Потери (64B)  : {C.BOLD}{stats_small['loss']:.1f}%{C.RESET} | "
        f"RTT avg={stats_small['avg']:.2f} ms | max={stats_small['max']:.2f} ms | "
        f"jitter (mdev)={C.BOLD}{stats_small['mdev']:.2f} ms{C.RESET}"
    )

    if stats_small["loss"] >= 100.0:
        print(f"\n{C.RED}{C.BOLD}[ВЕРДИКТ: OFFLINE]{C.RESET} Узел {target_ip} полностью недоступен по ICMP (100% потерь на 64B).")
        return 1

    # 2. Тест тяжелыми пакетами 1472 байта (полный MTU 1500 без фрагментации)
    print(f"\n{C.BLUE}[ТЕСТ 2/2]{C.RESET} Стресс-тест полного MTU 1500 (100 пакетов по 1472 байта: `ping -c 100 -i 0.01 -s 1472 -W 1 {target_ip}`)...")
    res_heavy = run_cmd(["ping", "-c", "100", "-i", "0.01", "-s", "1472", "-W", "1", target_ip])
    stats_heavy = parse_ping_output(res_heavy.stdout)
    print(
        f"  ➔ Потери (1472B): {C.BOLD}{stats_heavy['loss']:.1f}%{C.RESET} | "
        f"RTT avg={stats_heavy['avg']:.2f} ms | max={stats_heavy['max']:.2f} ms | "
        f"jitter (mdev)={C.BOLD}{stats_heavy['mdev']:.2f} ms{C.RESET}"
    )

    # Анализ деградации между 64B и 1472B
    jitter_spike = (
        stats_heavy["mdev"] > max(12.0, stats_small["mdev"] * 3.5)
        or stats_heavy["avg"] > max(20.0, stats_small["avg"] * 4.0)
    )
    has_l1_defect = (stats_heavy["loss"] > 1.0) or (stats_small["loss"] > 1.0) or jitter_spike

    print(f"\n{C.CYAN}{C.BOLD}════════════════════════ ИНЖЕНЕРНЫЙ ВЕРДИКТ ════════════════════════{C.RESET}")
    if has_l1_defect:
        print(
            f"{C.RED}{C.BOLD}[L1 DEFECT] Проблема с физическим кабелем, плохим обжимом RJ-45 или просадкой питания PoE{C.RESET}"
        )
        if stats_small["loss"] == 0.0 and stats_heavy["loss"] > 1.0:
            print(
                f"  {C.YELLOW}• Диагноз:{C.RESET} Мелкие пакеты (64B) проходят без потерь (0%), но на полном MTU (1472B) "
                f"теряется {stats_heavy['loss']:.1f}% кадров (типичный признак окисления контактов RJ-45, омедненки CCA или наводок)."
            )
        elif jitter_spike:
            print(
                f"  {C.YELLOW}• Диагноз:{C.RESET} Зафиксирован резкий скачок латентности/джиттера под нагрузкой "
                f"(mdev {stats_small['mdev']:.2f} ms ➔ {stats_heavy['mdev']:.2f} ms)."
            )
        else:
            print(
                f"  {C.YELLOW}• Диагноз:{C.RESET} Зафиксированы потери пакетов (64B: {stats_small['loss']:.1f}%, 1472B: {stats_heavy['loss']:.1f}%)."
            )
    else:
        print(
            f"{C.GREEN}{C.BOLD}[L1 OK] Физический кабель, обжим RJ-45 и линия PoE в отличном состоянии!{C.RESET}\n"
            f"  {C.DIM}Полный профиль MTU 1500 (1472B payload) держит нагрузку: потери {stats_heavy['loss']:.1f}%, mdev {stats_heavy['mdev']:.2f} ms.{C.RESET}"
        )

    return 0


