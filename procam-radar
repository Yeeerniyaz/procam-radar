def get_camera_vendor(mac: str) -> str:
    """Возвращает бренд камеры по MAC-префиксу (OUI) или пустую строку."""
    if not mac:
        return ""
    prefix = mac.strip().lower()[:8]
    return CAMERA_OUI_MAP.get(prefix, "")


def is_camera_mac(mac: str) -> bool:
    """Проверяет, принадлежит ли MAC-адрес известному производителю камер."""
    return bool(get_camera_vendor(mac))


