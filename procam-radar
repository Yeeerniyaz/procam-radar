        ensure_iface_up(wf_if)
        if get_carrier(wf_if) and wf_if not in active_scan_ifaces:
            active_scan_ifaces.append(wf_if)
    if not active_scan_ifaces:
        active_scan_ifaces = [iface]

    iface_descriptions = []
    for a_if in active_scan_ifaces:
        kind = "Кабель" if a_if in wired_ifaces else "Wi-Fi"
        addrs = [x["ip"] for x in get_iface_ipv4_list(a_if) if not x["label"].endswith(":yeee")]
        ip_lbl = addrs[0] if addrs else "L2 без IP"
        iface_descriptions.append(f"{a_if} ({kind}: {ip_lbl})")

    print(f"{C.BOLD}[АКТИВНЫЕ СЕТИ]{C.RESET} {C.GREEN}{C.BOLD}{' + '.join(iface_descriptions)}{C.RESET}")

    local_macs, local_ips = get_all_local_macs_and_ips()
    probe_src_ips = set(local_ips)
    gw_macs = set()
    for a_if in active_scan_ifaces:
        gw_macs |= get_default_gateway_macs(a_if)

    # Определяем основные подсети всех активных интерфейсов (исключая временные алиасы :yeee)
    primary_nets = []
    primary_net_by_iface = {}
    primary_ip = None
    for a_if in active_scan_ifaces:
        p_addrs = [item for item in get_iface_ipv4_list(a_if) if not item["label"].endswith(":yeee")]
        for item in p_addrs:
            if not primary_ip:
                primary_ip = item["ip"]
            octs = item["ip"].split(".")
            try:
                net_obj = ipaddress.IPv4Network(f"{octs[0]}.{octs[1]}.{octs[2]}.0/24", strict=False)
                if net_obj not in primary_nets:
                    primary_nets.append(net_obj)
                primary_net_by_iface.setdefault(a_if, []).append((net_obj, item["ip"]))
            except ValueError:
                pass

    if primary_nets:
        print(f"{C.BOLD}[УРОВЕНЬ А]{C.RESET} Родные подсети: {C.CYAN}{', '.join(str(n) for n in primary_nets)}{C.RESET}")
    else:
        print(f"{C.BOLD}[УРОВЕНЬ А]{C.RESET} {C.YELLOW}Основная IPv4-подсеть не назначена (прямой кабель L2 / чужие подсети){C.RESET}")
    print(f"{C.BOLD}[УРОВЕНЬ Б]{C.RESET} L2-провокация ONVIF (:3702), Hikvision SADP (:37020), Dahua (:37810) + перехват чужих подсетей")

    def is_in_primary_subnet(ip_str: str) -> bool:
        if not primary_nets:
            return False
        try:
            ip_obj = ipaddress.IPv4Address(ip_str)
            return any(ip_obj in net for net in primary_nets)
        except ValueError:
            return False

    # Хранилище: ip -> dict[mac -> entry_dict]
    nodes_by_ip = {}
    lock = threading.Lock()
    stop_sniff = threading.Event()

    def record_host(ip_str: str, mac_str: str, meta: dict = None, is_l2_proto: bool = False, pkt_iface: str = None):
        if not ip_str or ip_str in ("0.0.0.0", "255.255.255.255", "239.255.255.250", "239.255.255.251"):
            return
        if ip_str in probe_src_ips or ip_str.startswith(("127.", "224.", "239.")):
            return
        mac_str = (mac_str or "").lower()
        if not mac_str or mac_str in local_macs or mac_str in ("00:00:00:00:00:00", "ff:ff:ff:ff:ff:ff"):
            return

        meta = meta or {}
        eff_iface = pkt_iface or iface
        in_local = is_in_primary_subnet(ip_str)

        # Игнорируем транзитные внешние интернет-пакеты, приходящие через MAC роутера
        if not in_local and mac_str in gw_macs and not is_l2_proto and not is_camera_mac(mac_str):
            return

        vendor = meta.get("vendor") or get_camera_vendor(mac_str)
        with lock:
            mac_map = nodes_by_ip.setdefault(ip_str, {})
            entry = mac_map.get(mac_str)
            if not entry:
                mac_map[mac_str] = {
                    "ip": ip_str,
                    "mac": mac_str,
                    "vendor": vendor,
                    "model": meta.get("model", ""),
                    "serial": meta.get("serial", ""),
                    "firmware": meta.get("firmware", ""),
                    "ports": [],
                    "is_local_subnet": in_local,
                    "l2_discovery": is_l2_proto,
                    "iface": eff_iface,
                    "subnet_info": {},
                }
            else:
                if vendor and not entry["vendor"]:
                    entry["vendor"] = vendor
                for k in ("model", "serial", "firmware"):
                    if meta.get(k) and not entry.get(k):
                        entry[k] = meta[k]
                if is_l2_proto:
                    entry["l2_discovery"] = True
                if pkt_iface and pkt_iface in wired_ifaces:
                    entry["iface"] = pkt_iface

    # Поток 1: Сниффер Уровня Б и ARP по всем активным интерфейсам (Кабель + Wi-Fi)
    def radar_pkt_callback(pkt):
        if not pkt.haslayer(Ether):
            return
        s_mac = pkt[Ether].src.lower()
        if s_mac in local_macs or s_mac == "ff:ff:ff:ff:ff:ff":
            return

        p_if = getattr(pkt, "sniffed_on", iface) or iface

        if pkt.haslayer(ARP):
            psrc = pkt[ARP].psrc
            pdst = pkt[ARP].pdst
            if psrc == "0.0.0.0" and pdst and pdst != "0.0.0.0" and pdst not in probe_src_ips:
                record_host(pdst, s_mac, is_l2_proto=True, pkt_iface=p_if)
            elif psrc and psrc != "0.0.0.0":
                record_host(psrc, s_mac, is_l2_proto=not is_in_primary_subnet(psrc), pkt_iface=p_if)
            return

        if pkt.haslayer(IP):
            src_ip = pkt[IP].src
            parsed_meta = {}
            is_proto = False
            if pkt.haslayer(UDP) and pkt.haslayer(Raw):
                sport = pkt[UDP].sport
                dport = pkt[UDP].dport
                if sport in (3702, 37020, 37810) or dport in (3702, 37020, 37810):
                    parsed_meta = parse_xml_discovery_payload(bytes(pkt[Raw].load))
                    is_proto = True

            eff_ip = parsed_meta.get("ip") or src_ip
            if is_proto or is_camera_mac(s_mac) or not is_in_primary_subnet(eff_ip):
                record_host(eff_ip, s_mac, parsed_meta, is_l2_proto=is_proto, pkt_iface=p_if)

    def sniffer_worker():
        try:
            sniff(
                iface=active_scan_ifaces,
                timeout=3.4,
                store=False,
                prn=radar_pkt_callback,
                stop_filter=lambda _: stop_sniff.is_set(),
            )
        except Exception:
            pass

    # Поток 2: Отправка L2-провокаций (ONVIF, SADP, Dahua, ARP) на все активные интерфейсы
    def l2_prover_worker():
        time.sleep(0.1)
        for a_if in active_scan_ifaces:
            send_l2_provocations(a_if, probe_src_ips)
        time.sleep(1.4)
        if not stop_sniff.is_set():
            for a_if in active_scan_ifaces:
                send_l2_provocations(a_if, probe_src_ips)

    # Поток 3: Асинхронный ARP-sweep по родным подсетям всех активных интерфейсов
    def level_a_srp_worker():
        for a_if, net_tuples in primary_net_by_iface.items():
            src_mac = get_iface_mac(a_if)
            for net_obj, src_ip_for_if in net_tuples:
                targets = [str(h) for h in net_obj.hosts() if str(h) not in probe_src_ips]
                if not targets:
                    continue
                pkt_batch = Ether(src=src_mac, dst="ff:ff:ff:ff:ff:ff") / ARP(
                    op=1, hwsrc=src_mac, psrc=src_ip_for_if, pdst=targets
                )
                try:
                    ans, _ = srp(pkt_batch, iface=a_if, timeout=2.2, multi=True, verbose=False)
                    for _, rcv in ans:
                        if rcv.haslayer(Ether) and rcv.haslayer(ARP):
                            record_host(rcv[ARP].psrc, rcv[Ether].src.lower(), is_l2_proto=False, pkt_iface=a_if)
                except Exception:
                    pass

    print(f"\n{C.BLUE}{C.BOLD}[1/2] Параллельное сканирование Уровня А (/24) и Уровня Б (ONVIF/SADP/DHIP L2)...{C.RESET}")
    t_sniff = threading.Thread(target=sniffer_worker, daemon=True)
    t_l2 = threading.Thread(target=l2_prover_worker, daemon=True)
    t_srp = threading.Thread(target=level_a_srp_worker, daemon=True)

    t_sniff.start()
    t_l2.start()
    t_srp.start()

    t_srp.join(timeout=3.0)
    t_l2.join(timeout=3.2)
    t_sniff.join(timeout=3.6)
    stop_sniff.set()

    # Инъекция мостов :yeee на том интерфейсе, где ответила камера (без разрыва Wi-Fi!)
    all_ips = sorted(nodes_by_ip.keys())
    subnet_status_by_ip = {}
    for ip_str in all_ips:
        mac_dict = nodes_by_ip[ip_str]
        first_entry = next(iter(mac_dict.values()))
        target_if = first_entry.get("iface") or iface
        subnet_status_by_ip[ip_str] = inject_subnet_alias(target_if, ip_str)

    # Параллельная проверка портов (80, 443, 554, 8000, 37777) для всех откликнувшихся хостов
    print(f"{C.BLUE}{C.BOLD}[2/2] Проверка портов [80, 443, 554, 8000, 37777] на {len(all_ips)} откликнувшихся IP...{C.RESET}")
    ports_by_ip = {}
    if all_ips:
        def _scan_ip_ports(ip_target: str) -> list:
            open_p = []
            with ThreadPoolExecutor(max_workers=len(TARGET_PORTS)) as inner_ex:
                futs = {p: inner_ex.submit(check_single_port, ip_target, p, 0.55) for p in TARGET_PORTS}
                for p in TARGET_PORTS:
                    if futs[p].result():
                        open_p.append(p)
            return open_p

        with ThreadPoolExecutor(max_workers=min(32, max(1, len(all_ips)))) as outer_ex:
            ip_futures = {ip_str: outer_ex.submit(_scan_ip_ports, ip_str) for ip_str in all_ips}
            for ip_str, fut in ip_futures.items():
                ports_by_ip[ip_str] = fut.result()

    # Формируем требуемую структуру: ip -> list of {mac, vendor, model, ports, is_local_subnet, ...}
    ip_to_entries = {}
    local_subnet_cameras = []
    foreign_subnet_cameras = []
    conflict_ips = {}
    cache_cameras_list = []

    CAMERA_SPECIFIC_PORTS = {554, 8000, 37777}

    for ip_str in all_ips:
        mac_dict = nodes_by_ip[ip_str]
        open_ports = ports_by_ip.get(ip_str, [])
        sub_info = subnet_status_by_ip.get(ip_str, {})
        entries = []

        for mac_str, item in mac_dict.items():
            item["ports"] = open_ports
            item["open_ports"] = open_ports
            item["subnet_info"] = sub_info
            item["iface"] = item.get("iface") or iface
            enrich_camera_record(item)
            entries.append(item)

        ip_to_entries[ip_str] = entries
        is_conflict = len(entries) >= 2

        # Определяем, относится ли узел к камерам:
        # Уровень А: открыт хотя бы один из 554, 8000, 37777 ИЛИ MAC производителя камер ИЛИ L2 ONVIF/SADP/DHIP ответ
        # Уровень Б: любой обнаруженный узел из чужой подсети
        has_cam_port = any(p in CAMERA_SPECIFIC_PORTS for p in open_ports)
        any_cam_mac_or_l2 = any(is_camera_mac(e["mac"]) or e.get("l2_discovery") for e in entries)

        if is_conflict:
            conflict_ips[ip_str] = entries

        for entry in entries:
            entry["conflict"] = is_conflict
            if entry["is_local_subnet"]:
                if has_cam_port or is_camera_mac(entry["mac"]) or entry.get("l2_discovery"):
                    local_subnet_cameras.append(entry)
                    cache_cameras_list.append(entry)
            else:
                if has_cam_port or any_cam_mac_or_l2 or open_ports or not entry["is_local_subnet"]:
                    foreign_subnet_cameras.append(entry)
                    cache_cameras_list.append(entry)

    save_last_scan_cache(iface, "scan", cache_cameras_list)
    elapsed_total = time.time() - start_wall

    # ==========================================================================
    # НАГЛЯДНЫЙ РАЗДЕЛЬНЫЙ ВЫВОД В ТЕРМИНАЛ (3 ЧЕТКИЕ СЕКЦИИ)
    # ==========================================================================
    print(f"\n{C.CYAN}{C.BOLD}════════════════════════ РЕЗУЛЬТАТЫ РАДАРА ({elapsed_total:.1f} сек) ════════════════════════{C.RESET}")

    # СЕКЦИЯ 1: КАМЕРЫ В ТВОЕЙ ПОДСЕТИ
    print(f"\n{C.GREEN}{C.BOLD}[🟢 КАМЕРЫ В ТВОЕЙ ПОДСЕТИ (Родная сеть роутера)]{C.RESET}")
    if not local_subnet_cameras:
        print(f"  {C.DIM}В основной подсети ({', '.join(str(n) for n in primary_nets) or 'нет'}) IP-камер не обнаружено.{C.RESET}")
    else:
        for cam in local_subnet_cameras:
            c_badge = f" {C.RED}{C.BOLD}[КОНФЛИКТ IP!]{C.RESET}" if cam.get("conflict") else ""
            ports_s = ", ".join(str(p) for p in cam["ports"]) if cam["ports"] else "нет открытых"
            model_s = f" | Модель: {cam['model']}" if cam.get("model") and not cam["model"].startswith("Н/Д") else ""
            print(
                f"  {C.GREEN}●{C.RESET} IP: {C.CYAN}{C.BOLD}{cam['ip']:<15}{C.RESET}{c_badge} | "
                f"MAC: {C.YELLOW}{cam['mac_upper']}{C.RESET} | "
                f"Бренд: {C.MAGENTA}{C.BOLD}{cam['vendor_resolved']}{C.RESET}{model_s}\n"
                f"    Порты: [{ports_s}] | Веб: {C.BLUE}{C.BOLD}{cam['web_link']}{C.RESET} | RTSP: {C.CYAN}{cam['rtsp_link']}{C.RESET}"
            )

    # СЕКЦИЯ 2: КАМЕРЫ В ЧУЖОЙ ПОДСЕТИ
    print(f"\n{C.YELLOW}{C.BOLD}[🟡 КАМЕРЫ В ЧУЖОЙ ПОДСЕТИ (Доступ прокинут через алиас)]{C.RESET}")
    if not foreign_subnet_cameras:
        print(f"  {C.DIM}Устройств в чужих подсетях не обнаружено.{C.RESET}")
    else:
        for cam in foreign_subnet_cameras:
            c_badge = f" {C.RED}{C.BOLD}[КОНФЛИКТ IP!]{C.RESET}" if cam.get("conflict") else ""
            ports_s = ", ".join(str(p) for p in cam["ports"]) if cam["ports"] else "нет открытых"
            alias_s = cam.get("subnet_info", {}).get("status", "-")
            model_s = f" | Модель: {cam['model']}" if cam.get("model") and not cam["model"].startswith("Н/Д") else ""
            print(
                f"  {C.YELLOW}●{C.RESET} IP: {C.CYAN}{C.BOLD}{cam['ip']:<15}{C.RESET}{c_badge} | "
                f"MAC: {C.YELLOW}{cam['mac_upper']}{C.RESET} | "
                f"Бренд: {C.MAGENTA}{C.BOLD}{cam['vendor_resolved']}{C.RESET}{model_s}\n"
                f"    Алиас : {C.GREEN}{alias_s}{C.RESET}\n"
                f"    Порты : [{ports_s}] | Веб: {C.BLUE}{C.BOLD}{cam['web_link']}{C.RESET} | RTSP: {C.CYAN}{cam['rtsp_link']}{C.RESET}"
            )

    # СЕКЦИЯ 3: КАМЕРЫ НА ОДНОМ И ТОМ ЖЕ IP (Конфликт адресов)
    print(f"\n{C.RED}{C.BOLD}[🔴 КАМЕРЫ НА ОДНОМ И ТОМ ЖЕ IP (Конфликт адресов)]{C.RESET}")
    if not conflict_ips:
        print(f"  {C.GREEN}✔ Конфликтов IP-адресов не обнаружено (каждый IP принадлежит уникальному MAC).{C.RESET}")
    else:
        for cip, entries in conflict_ips.items():
            print(f"  {C.RED}{C.BOLD}⚠ [КОНФЛИКТ IP!] На адресе {cip} обнаружено сразу {len(entries)} устройств(а):{C.RESET}")
            for e in entries:
                print(f"    {C.RED}➔{C.RESET} MAC: {C.YELLOW}{C.BOLD}{e['mac_upper']}{C.RESET} — {C.MAGENTA}{e['vendor_resolved']}{C.RESET} ({e.get('model', 'Н/Д')})")
            print(
                f"    {C.YELLOW}{C.BOLD}Рекомендация:{C.RESET} Временно отключите одну из конфликтных камер от свитча/роутера "
                f"и смените IP оставшейся через:\n"
                f"    {C.WHITE}{C.BOLD}yeee set-ip {cip} <НОВЫЙ_IP> admin <ПАРОЛЬ>{C.RESET}"
            )

    print(f"\n{C.DIM}Подсказка: `yeee open <IP>` — открыть камеру в браузере | `yeee dump` — сохранить отчет | `yeee clean` — убрать алиасы{C.RESET}")
    return 0


# ==============================================================================
# PRO SUITE ФУНКЦИИ: INFO, FREE, PLAY, SNAP, ACTIVATE, WATCH (agent_08_pro_suite)
# ==============================================================================
def run_info_camera(target_ip: str) -> int:
    """Глубокая беспарольная инспекция камеры: ONVIF-часы, статус активации, RTSP-баннер, SSL-сертификат."""
    try:
        ipaddress.IPv4Address(target_ip)
    except ValueError:
        print(f"{C.RED}[ОШИБКА] Некорректный IPv4-адрес: {target_ip}{C.RESET}")
        return 1

    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}  YEEE INFO — Глубокая инспекция узла {target_ip} БЕЗ пароля{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")

    try:
        iface, _, _, _ = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    sub_info = inject_subnet_alias(iface, target_ip)
    open_ports = scan_camera_ports(target_ip)

    # 1. Получаем MAC-адрес из ARP или через srp
    mac_found = ""
    src_mac = get_iface_mac(iface)
    ipv4_list = get_iface_ipv4_list(iface)
    src_ip = sub_info.get("alias_ip") or (ipv4_list[0]["ip"] if ipv4_list else "192.168.1.250")
    try:
        ans, _ = srp(
            Ether(src=src_mac, dst="ff:ff:ff:ff:ff:ff") / ARP(op=1, hwsrc=src_mac, psrc=src_ip, pdst=target_ip),
            iface=iface,
            timeout=1.0,
            verbose=False,
        )
        for _, rcv in ans:
            if rcv.haslayer(Ether):
                mac_found = rcv[Ether].src.lower()
                break
    except Exception:
        pass

    vendor = get_camera_vendor(mac_found) if mac_found else "Не определен по OUI"

    # 2. Беспарольный запрос ONVIF GetSystemDateAndTime
    onvif_time_str = "Не поддерживает / закрыт"
    drift_str = "-"
    if requests and (80 in open_ports or 8000 in open_ports or 443 in open_ports):
        soap_dt = (
            '<?xml version="1.0" encoding="utf-8"?>'
            '<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" '
            'xmlns:tds="http://www.onvif.org/ver10/device/wsdl">'
            "<s:Body><tds:GetSystemDateAndTime/></s:Body></s:Envelope>"
        )
        try:
            r = requests.post(
                f"http://{target_ip}/onvif/device_service",
                data=soap_dt,
                headers={"Content-Type": "application/soap+xml; charset=utf-8"},
                timeout=1.8,
            )
            if r.status_code == 200 and "UTCDateTime" in r.text:
                m_yr = re.search(r"<(?:\w+:)?Year>(\d+)</(?:\w+:)?Year>", r.text)
                m_mo = re.search(r"<(?:\w+:)?Month>(\d+)</(?:\w+:)?Month>", r.text)
                m_da = re.search(r"<(?:\w+:)?Day>(\d+)</(?:\w+:)?Day>", r.text)
                m_hr = re.search(r"<(?:\w+:)?Hour>(\d+)</(?:\w+:)?Hour>", r.text)
                m_mi = re.search(r"<(?:\w+:)?Minute>(\d+)</(?:\w+:)?Minute>", r.text)
                m_se = re.search(r"<(?:\w+:)?Second>(\d+)</(?:\w+:)?Second>", r.text)
                if all([m_yr, m_mo, m_da, m_hr, m_mi, m_se]):
                    cam_utc = datetime(
                        int(m_yr.group(1)),
                        int(m_mo.group(1)),
                        int(m_da.group(1)),
                        int(m_hr.group(1)),
                        int(m_mi.group(1)),
                        int(m_se.group(1)),
                        tzinfo=timezone.utc,
                    )
                    now_utc = datetime.now(timezone.utc)
                    diff_sec = int((cam_utc - now_utc).total_seconds())
                    onvif_time_str = cam_utc.strftime("%Y-%m-%d %H:%M:%S UTC")
                    if abs(diff_sec) <= 5:
                        drift_str = f"{C.GREEN}Норма (расхождение {diff_sec:+d} сек){C.RESET}"
                    else:
                        drift_str = f"{C.RED}{C.BOLD}СБИТЫ ЧАСЫ! Расхождение {diff_sec:+d} сек (настройте NTP){C.RESET}"
        except Exception:
            pass

    # 3. Проверка статуса активации и HTTP заголовков
    http_server = "-"
    activation_status = "Неизвестно"
    if requests and (80 in open_ports or 443 in open_ports):
        scheme = "https" if (443 in open_ports and 80 not in open_ports) else "http"
        try:
            r_root = requests.get(f"{scheme}://{target_ip}/", timeout=1.5, verify=False)
            http_server = r_root.headers.get("Server", "-")
        except Exception:
            pass
        try:
            r_act = requests.get(f"{scheme}://{target_ip}/SDK/activateStatus", timeout=1.5, verify=False)
            if "<Activated>false</Activated>" in r_act.text:
                activation_status = f"{C.YELLOW}{C.BOLD}INACTIVE (Новая с завода — пароля еще НЕТ!){C.RESET}"
            elif "<Activated>true</Activated>" in r_act.text:
                activation_status = f"{C.GREEN}ACTIVE (Активирована, установлен пароль){C.RESET}"
        except Exception:
            pass

    # 4. Опрос RTSP OPTIONS на порту 554
    rtsp_banner = "-"
    if 554 in open_ports:
        try:
            with socket.create_connection((target_ip, 554), timeout=1.2) as s:
                req = f"OPTIONS rtsp://{target_ip}:554/ RTSP/1.0\r\nCSeq: 1\r\nUser-Agent: YEEE-Pro\r\n\r\n"
                s.sendall(req.encode("ascii"))
                data = s.recv(1024).decode("utf-8", errors="ignore")
                m_srv = re.search(r"Server:\s*([^\r\n]+)", data, re.I)
                if m_srv:
                    rtsp_banner = m_srv.group(1).strip()
                else:
                    first_line = data.splitlines()[0] if data.splitlines() else ""
                    rtsp_banner = first_line
        except Exception:
            pass

    # 5. Извлечение Subject из SSL-сертификата на порту 443
    tls_subject = "-"
    if 443 in open_ports:
        try:
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            with socket.create_connection((target_ip, 443), timeout=1.5) as sock:
                with ctx.wrap_socket(sock, server_hostname=target_ip) as ssock:
                    der_cert = ssock.getpeercert(binary_form=True)
                    if der_cert:
                        pem = ssl.DER_cert_to_PEM_cert(der_cert)
                        p_res = subprocess.run(
                            ["openssl", "x509", "-noout", "-subject"],
                            input=pem,
                            stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE,
                            text=True,
                        )
                        if p_res.returncode == 0 and p_res.stdout.strip():
                            tls_subject = p_res.stdout.strip().replace("subject=", "").strip()
        except Exception:
            pass

    ports_s = ", ".join(str(p) for p in open_ports) if open_ports else "Нет открытых из [80, 443, 8000, 554, 37777]"
    print(f"  {C.BOLD}IP-адрес          :{C.RESET} {C.CYAN}{C.BOLD}{target_ip}{C.RESET} ({sub_info.get('status')})")
    print(f"  {C.BOLD}MAC-адрес         :{C.RESET} {C.YELLOW}{mac_found.upper() if mac_found else 'Н/Д (не в L2/ARP)'}{C.RESET}")
    print(f"  {C.BOLD}Вендор (OUI)      :{C.RESET} {C.MAGENTA}{vendor}{C.RESET}")
    print(f"  {C.BOLD}Открытые порты    :{C.RESET} {ports_s}")
    print(f"  {C.BOLD}Статус активации  :{C.RESET} {activation_status}")
    print(f"  {C.BOLD}HTTP Server       :{C.RESET} {http_server}")
    print(f"  {C.BOLD}RTSP Banner (:554):{C.RESET} {rtsp_banner}")
    print(f"  {C.BOLD}TLS Сертификат    :{C.RESET} {tls_subject}")
    print(f"  {C.BOLD}Часы камеры (ONVIF):{C.RESET} {onvif_time_str}")
    print(f"  {C.BOLD}Синхронизация NTP :{C.RESET} {drift_str}")
    return 0


def run_free_ips(count: int = 10, target_subnet: str = None) -> int:
    """
    Сканирует /24 подсеть и выдает гарантированно свободный пул из count IP-адресов под камеры.
    Корректно работает даже когда одновременно подключены кабель (без DHCP) и Wi-Fi роутер!
    """
    count = max(1, min(245, int(count)))
    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}  PROCAM RADAR — Подбор {count} свободных IP-адресов для монтажа камер{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")

    try:
        iface, _, wired_ifaces, wifi_ifaces = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    # Ищем интерфейс с активной IPv4-подсетью (если кабель воткнут напрямую в камеру без роутера — берем подсеть Wi-Fi роутера)
    primary_addrs = [item for item in get_iface_ipv4_list(iface) if not item["label"].endswith(":yeee")]
    if not primary_addrs:
        for candidate_if in wifi_ifaces + wired_ifaces:
            cand_addrs = [item for item in get_iface_ipv4_list(candidate_if) if not item["label"].endswith(":yeee")]
            if cand_addrs:
                iface = candidate_if
                primary_addrs = cand_addrs
                break

    if target_subnet:
        octs = target_subnet.split("/")[0].split(".")
        if len(octs) >= 3:
            prefix_24 = f"{octs[0]}.{octs[1]}.{octs[2]}"
            my_ip = primary_addrs[0]["ip"] if primary_addrs else f"{prefix_24}.250"
        else:
            print(f"{C.RED}[ОШИБКА] Некорректный формат подсети: {target_subnet}{C.RESET}")
            return 1
    elif primary_addrs:
        my_ip = primary_addrs[0]["ip"]
        octs = my_ip.split(".")
        prefix_24 = f"{octs[0]}.{octs[1]}.{octs[2]}"
    else:
        prefix_24 = "192.168.1"
        my_ip = "192.168.1.250"
        inject_subnet_alias(iface, "192.168.1.1")

    net_cidr = f"{prefix_24}.0/24"
    net_obj = ipaddress.IPv4Network(net_cidr, strict=False)

    print(f"{C.BOLD}[ПОДСЕТЬ]{C.RESET} {C.GREEN}{net_cidr}{C.RESET} на интерфейсе {C.BOLD}{iface}{C.RESET} (ваш IP: {my_ip})")
    print(f"{C.BOLD}[ЗАПРОС]{C.RESET}  Необходимо свободных IP-адресов: {C.CYAN}{C.BOLD}{count}{C.RESET}")
    print(f"{C.BLUE}[СКАН]{C.RESET}    Проверка всех 254 адресов (ARP-опрос + проверка портов)...")

    occupied = {my_ip, f"{prefix_24}.1", f"{prefix_24}.250", f"{prefix_24}.249", f"{prefix_24}.248"}
    src_mac = get_iface_mac(iface)

    # 1. Быстрый ARP-sweep через Scapy srp
    targets = [str(h) for h in net_obj.hosts() if str(h) != my_ip]
    try:
        ans, _ = srp(
            Ether(src=src_mac, dst="ff:ff:ff:ff:ff:ff") / ARP(op=1, hwsrc=src_mac, psrc=my_ip, pdst=targets),
            iface=iface,
            timeout=1.8,
            verbose=False,
        )
        for _, rcv in ans:
            if rcv.haslayer(ARP):
                occupied.add(rcv[ARP].psrc)
    except Exception:
        pass

    free_all = [f"{prefix_24}.{i}" for i in range(2, 248) if f"{prefix_24}.{i}" not in occupied]
    preferred = [f"{prefix_24}.{i}" for i in range(100, 245) if f"{prefix_24}.{i}" not in occupied]

    # Ищем непрерывный блок из count адресов
    best_block = []
    search_pool = preferred if len(preferred) >= count else free_all
    cur_block = []
    prev_last = None
    for ip_s in search_pool:
        last_oct = int(ip_s.split(".")[-1])
        if prev_last is None or last_oct == prev_last + 1:
            cur_block.append(ip_s)
        else:
            cur_block = [ip_s]
        prev_last = last_oct
        if len(cur_block) == count:
            best_block = list(cur_block)
            break

    if not best_block:
        best_block = search_pool[:count]

    print(f"\n  {C.GREEN}✔ Занято адресов в подсети :{C.RESET} {len(occupied)}")
    print(f"  {C.GREEN}✔ Всего свободно адресов   :{C.RESET} {len(free_all)}")
    if best_block:
        print(
            f"\n{C.GREEN}{C.BOLD}🎯 РЕКОМЕНДУЕМЫЙ СВОБОДНЫЙ ДИАПАЗОН ДЛЯ {len(best_block)} КАМЕР:{C.RESET}\n"
            f"   {C.CYAN}{C.BOLD}{best_block[0]}  ──►  {best_block[-1]}{C.RESET} (Маска: 255.255.255.0 | Шлюз: {prefix_24}.1)"
        )
        print(f"   {C.DIM}Список ({len(best_block)} шт.): {', '.join(best_block)}{C.RESET}")
    return 0


def run_play_camera(target_ip: str, username: str = None, password: str = None, sub_stream: bool = False) -> int:
    """Открывает живой RTSP-видеопоток камеры в окне ffplay / mpv / vlc от имени $SUDO_USER."""
    try:
        ipaddress.IPv4Address(target_ip)
    except ValueError:
        print(f"{C.RED}[ОШИБКА] Некорректный IPv4-адрес: {target_ip}{C.RESET}")
        return 1

    try:
        iface, _, _, _ = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    inject_subnet_alias(iface, target_ip)
    open_ports = scan_camera_ports(target_ip)
    u = username if username is not None else "admin"
    p = password if password is not None else "admin"

    channel = "102" if sub_stream else "101"
    subtype = "1" if sub_stream else "0"
    if 37777 in open_ports:
        rtsp_url = f"rtsp://{u}:{p}@{target_ip}:554/cam/realmonitor?channel=1&subtype={subtype}"
    else:
        rtsp_url = f"rtsp://{u}:{p}@{target_ip}:554/Streaming/Channels/{channel}"

    player_cmd = None
    if shutil.which("ffplay"):
        player_cmd = ["ffplay", "-rtsp_transport", "tcp", "-window_title", f"YEEE LIVE: {target_ip}", rtsp_url]
    elif shutil.which("mpv"):
        player_cmd = ["mpv", "--rtsp-transport=tcp", f"--title=YEEE LIVE: {target_ip}", rtsp_url]
    elif shutil.which("vlc"):
        player_cmd = ["vlc", rtsp_url]

    if not player_cmd:
        print(f"{C.RED}[ОШИБКА] Видеоплеер (ffplay / mpv / vlc) не найден. Установите: sudo apt install ffmpeg{C.RESET}")
        return 1

    print(f"{C.CYAN}{C.BOLD}[YEEE PLAY]{C.RESET} Запуск видеопотока {C.BOLD}{rtsp_url}{C.RESET} ({player_cmd[0]})...")
    ok = run_gui_as_sudo_user(player_cmd)
    return 0 if ok else 1


def run_snap_camera(target_ip: str, username: str = None, password: str = None) -> int:
    """Захватывает JPEG-снапшот с камеры (HTTP ISAPI / Dahua CGI / RTSP ffmpeg) и привязывает его к отчету."""
    try:
        ipaddress.IPv4Address(target_ip)
    except ValueError:
        print(f"{C.RED}[ОШИБКА] Некорректный IPv4-адрес: {target_ip}{C.RESET}")
        return 1

    try:
        iface, _, _, _ = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    inject_subnet_alias(iface, target_ip)
    creds = [(username, password)] if (username is not None and password is not None) else DEFAULT_CREDENTIAL_CANDIDATES
    out_file = os.path.join(os.getcwd(), f"snap_{target_ip.replace('.', '_')}.jpg")

    print(f"{C.CYAN}{C.BOLD}[YEEE SNAP]{C.RESET} Захват стоп-кадра с камеры {C.BOLD}{target_ip}{C.RESET}...")
    saved = False

    # 1. Пробуем HTTP Snapshot API (Hikvision ISAPI / Dahua CGI)
    if requests:
        endpoints = [
            f"http://{target_ip}/ISAPI/Streaming/channels/101/picture",
            f"http://{target_ip}/cgi-bin/snapshot.cgi",
            f"http://{target_ip}/onvif-http/snapshot?Profile_1",
        ]
        for u, p in creds:
            for url in endpoints:
                try:
                    r = requests.get(url, auth=HTTPDigestAuth(u, p), timeout=2.5, verify=False)
                    if r.status_code == 200 and r.content[:2] == b"\xff\xd8":
                        with open(out_file, "wb") as f:
                            f.write(r.content)
                        saved = True
                        break
                except Exception:
                    pass
            if saved:
                break

    # 2. Fallback через ffmpeg RTSP
    if not saved and shutil.which("ffmpeg"):
        for u, p in creds[:3]:
            for rtsp_path in (
                f"rtsp://{u}:{p}@{target_ip}:554/Streaming/Channels/101",
                f"rtsp://{u}:{p}@{target_ip}:554/cam/realmonitor?channel=1&subtype=0",
            ):
                res = run_cmd([
                    "ffmpeg", "-y", "-rtsp_transport", "tcp",
                    "-i", rtsp_path,
                    "-frames:v", "1", "-q:v", "2", out_file,
                ])
                if res.returncode == 0 and os.path.exists(out_file) and os.path.getsize(out_file) > 0:
                    saved = True
                    break
            if saved:
                break

    if not saved:
        print(f"  {C.RED}✖ Не удалось получить кадр с {target_ip} (проверьте доступность камеры и логин/пароль).{C.RESET}")
        return 1

    owner = chown_to_sudo_user(out_file)
    # Обновляем путь снапшота в LAST_SCAN_CACHE для автоматической вставки в PDF
    if os.path.exists(LAST_SCAN_CACHE):
        try:
            with open(LAST_SCAN_CACHE, "r", encoding="utf-8") as f:
                cdata = json.load(f)
            for cam in cdata.get("cameras", []):
                if cam.get("ip") == target_ip:
                    cam["snapshot_path"] = out_file
            with open(LAST_SCAN_CACHE, "w", encoding="utf-8") as f:
                json.dump(cdata, f, ensure_ascii=False, indent=2)
        except Exception:
            pass

    print(f"  {C.GREEN}✔ Кадр сохранен:{C.RESET} {C.BOLD}{out_file}{C.RESET} (владелец: {C.CYAN}{owner}{C.RESET})")
    return 0


def run_activate_cameras(new_password: str, start_ip: str = None) -> int:
    """
    Пакетная активация новых камер «из коробки» (Hikvision 192.168.1.64 / Dahua 192.168.1.108):
    Изолирует каждую по MAC через ip neigh replace, отправляет пакет активации и при указании START_IP раздает новые IP.
    """
    if len(new_password) < 8:
        print(f"{C.YELLOW}[!] Внимание: рекомендуется пароль от 8 символов с буквами и цифрами (требование Hikvision/Dahua).{C.RESET}")

    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}  YEEE ACTIVATE — Пакетная активация новых камер «из коробки»{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")

    try:
        iface, _, _, _ = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    factory_ips = ["192.168.1.64", "192.168.1.108", "192.168.0.64", "192.168.1.100"]
    for f_ip in factory_ips:
        inject_subnet_alias(iface, f_ip)

    src_mac = get_iface_mac(iface)
    local_macs, _ = get_all_local_macs_and_ips()
    targets = []  # list of (ip, mac)

    for f_ip in factory_ips:
        octs = f_ip.split(".")
        probe_ip = f"{octs[0]}.{octs[1]}.{octs[2]}.250"
        try:
            ans, _ = srp(
                Ether(src=src_mac, dst="ff:ff:ff:ff:ff:ff") / ARP(op=1, hwsrc=src_mac, psrc=probe_ip, pdst=f_ip),
                iface=iface,
                timeout=1.0,
                multi=True,
                verbose=False,
            )
            for _, rcv in ans:
                if rcv.haslayer(Ether) and rcv.haslayer(ARP):
                    m = normalize_mac(rcv[Ether].src)
                    if m and m not in local_macs and (f_ip, m) not in targets:
                        targets.append((f_ip, m))
        except Exception:
            pass

    if not targets:
        print(f"{C.YELLOW}[РЕЗУЛЬТАТ]{C.RESET} Камер на заводских адресах ({', '.join(factory_ips)}) не обнаружено.")
        return 0

    print(f"  {C.GREEN}✔ Найдено камер на заводских IP:{C.RESET} {len(targets)}")
    base_ip_obj = ipaddress.IPv4Address(start_ip) if start_ip else None

    for idx, (cam_ip, cam_mac) in enumerate(targets):
        print(f"\n{C.MAGENTA}{C.BOLD}>>> Активация #{idx + 1}: IP={cam_ip} | MAC={cam_mac.upper()}{C.RESET}")
        run_cmd(["ip", "neigh", "replace", cam_ip, "lladdr", cam_mac, "nud", "permanent", "dev", iface])
        try:
            if requests:
                act_xml = f'<?xml version="1.0" encoding="UTF-8"?><ActivateInfo><password>{new_password}</password></ActivateInfo>'
                try:
                    r = requests.put(
                        f"http://{cam_ip}/ISAPI/System/activate",
                        data=act_xml.encode("utf-8"),
                        headers={"Content-Type": "application/xml"},
                        timeout=3.0,
                        verify=False,
                    )
                    if r.status_code == 200 or "OK" in r.text:
                        print(f"  {C.GREEN}✔ Камера {cam_mac.upper()} успешно активирована через ISAPI!{C.RESET}")
                    else:
                        print(f"  {C.YELLOW}➔ Ответ активации HTTP {r.status_code} (возможно, уже активирована).{C.RESET}")
                except Exception as exc:
                    print(f"  {C.DIM}➔ Ошибка запроса активации: {type(exc).__name__}{C.RESET}")
        finally:
            run_cmd(["ip", "neigh", "del", cam_ip, "dev", iface])

        if base_ip_obj:
            assigned_ip = str(base_ip_obj + idx)
            run_set_ip(cam_ip, assigned_ip, "admin", new_password, target_mac=cam_mac)

    return 0


