# КОМАНДА SET-IP И RESOLVE: СМЕНА IP И РАЗВЕДЕНИЕ КОЛЛИЗИЙ ПО MAC (agent_05 / agent_07)
# ==============================================================================
def normalize_mac(mac_str: str) -> str:
    if not mac_str:
        return ""
    m = mac_str.strip().lower().replace("-", ":")
    if re.match(r"^([0-9a-f]{2}:){5}[0-9a-f]{2}$", m):
        return m
    return ""


