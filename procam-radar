def run_resolve_conflicts(
    conflict_ip: str,
    start_new_ip: str,
    username: str,
    password: str,
    gateway: str = None,
) -> int:
    """
    Пакетный режим бесконтактного разведения камер, сидящих на одном IP (yeee resolve):
    1. Находит все MAC-адреса, откликающиеся на <CONFLICT_IP>.
    2. По очереди фиксирует каждый MAC через `ip neigh replace <CONFLICT_IP> lladdr <MAC> nud permanent dev <iface>`,
       меняет IP на <START_NEW_IP> + i и снимает ARP-запись (`ip neigh del <CONFLICT_IP> dev <iface>`).
    """
    try:
        ipaddress.IPv4Address(conflict_ip)
        base_new_ip_obj = ipaddress.IPv4Address(start_new_ip)
    except ValueError as exc:
        print(f"{C.RED}[ОШИБКА] Некорректный IPv4-адрес: {exc}{C.RESET}")
        return 1

    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}  YEEE RESOLVE — Пакетное разведение конфликтующих камер по MAC{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")

    try:
        iface, _, _, _ = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    sub_info = inject_subnet_alias(iface, conflict_ip)
    print(f"{C.BOLD}[ИНТЕРФЕЙС]{C.RESET} {C.GREEN}{iface}{C.RESET} | {sub_info.get('status')}")
    print(f"{C.BLUE}[ПОИСК КОЛЛИЗИЙ]{C.RESET} Сбор всех MAC-адресов, сидящих на {C.YELLOW}{C.BOLD}{conflict_ip}{C.RESET}...")

    local_macs, _ = get_all_local_macs_and_ips()
    src_mac = get_iface_mac(iface)
    ipv4_list = get_iface_ipv4_list(iface)
    src_ip = sub_info.get("alias_ip") or (ipv4_list[0]["ip"] if ipv4_list else "192.168.1.250")

    found_macs = set()

    # Проверяем кэш последнего сканирования на случай уже зафиксированных MAC
    if os.path.exists(LAST_SCAN_CACHE):
        try:
            with open(LAST_SCAN_CACHE, "r", encoding="utf-8") as f:
                cdata = json.load(f)
            for cam in cdata.get("cameras", []):
                if cam.get("ip") == conflict_ip and cam.get("mac"):
                    m_norm = normalize_mac(cam["mac"])
                    if m_norm and m_norm not in local_macs:
                        found_macs.add(m_norm)
        except Exception:
            pass

    # Активный мульти-ARP опрос конфликтного IP
    arp_req = Ether(src=src_mac, dst="ff:ff:ff:ff:ff:ff") / ARP(
        op=1, hwsrc=src_mac, psrc=src_ip, hwdst="00:00:00:00:00:00", pdst=conflict_ip
    )
    try:
        ans, _ = srp([arp_req, arp_req, arp_req], iface=iface, timeout=2.0, multi=True, verbose=False)
        for _, rcv in ans:
            if rcv.haslayer(Ether) and rcv.haslayer(ARP):
                if rcv[ARP].psrc == conflict_ip:
                    m_norm = normalize_mac(rcv[Ether].src)
                    if m_norm and m_norm not in local_macs:
                        found_macs.add(m_norm)
    except Exception:
        pass

    sorted_macs = sorted(found_macs)
    if not sorted_macs:
        print(f"\n{C.YELLOW}[РЕЗУЛЬТАТ]{C.RESET} На адресе {conflict_ip} не откликнулось ни одного устройства.")
        return 1

    print(f"  {C.GREEN}✔ Обнаружено устройств на {conflict_ip}:{C.RESET} {C.BOLD}{len(sorted_macs)}{C.RESET}")
    for i, m in enumerate(sorted_macs, 1):
        v = get_camera_vendor(m) or "Сетевое устройство"
        print(f"    {i}. MAC: {C.YELLOW}{C.BOLD}{m.upper()}{C.RESET} ({C.MAGENTA}{v}{C.RESET})")

    summary = []
    for idx, target_mac in enumerate(sorted_macs):
        assigned_ip = str(base_new_ip_obj + idx)
        print(
            f"\n{C.MAGENTA}{C.BOLD}>>> [КАМЕРА #{idx + 1}/{len(sorted_macs)}]{C.RESET} "
            f"Перевод MAC {C.YELLOW}{target_mac.upper()}{C.RESET}: {conflict_ip} ➔ {C.GREEN}{C.BOLD}{assigned_ip}{C.RESET}"
        )
        rc = run_set_ip(
            old_ip=conflict_ip,
            new_ip=assigned_ip,
            username=username,
            password=password,
            gateway=gateway,
            target_mac=target_mac,
        )
        summary.append((target_mac.upper(), conflict_ip, assigned_ip, rc == 0))

    print(f"\n{C.CYAN}{C.BOLD}══════════════════ СВОДКА РАЗВЕДЕНИЯ КОНФЛИКТА ══════════════════{C.RESET}")
    for mac_u, o_ip, n_ip, ok in summary:
        status_s = f"{C.GREEN}✔ УСПЕШНО{C.RESET}" if ok else f"{C.RED}✖ ОШИБКА/ТАЙМАУТ{C.RESET}"
        print(f"  • MAC {C.YELLOW}{mac_u}{C.RESET}: {o_ip} ➔ {C.CYAN}{C.BOLD}{n_ip:<15}{C.RESET} [{status_s}]")
    return 0


