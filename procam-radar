def xml_escape(val: str) -> str:
    """Безопасное экранирование символов для ReportLab Paragraph XML парсера."""
    return (
        str(val or "")
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
    )


