def get_default_gateway_macs(iface: str) -> set:
    """Определяет MAC-адрес(а) шлюза по умолчанию, чтобы не принимать транзитный интернет-трафик за L2-камеру."""
    gw_ips = set()
    res = run_cmd(["ip", "-4", "route", "show", "default", "dev", iface])
    if res.returncode == 0:
        for line in res.stdout.splitlines():
            parts = line.split()
            if "via" in parts:
                idx = parts.index("via")
                if idx + 1 < len(parts):
                    gw_ips.add(parts[idx + 1])

    gw_macs = set()
    try:
        with open("/proc/net/arp", "r") as f:
            for line in f.read().splitlines()[1:]:
                parts = line.split()
                if len(parts) >= 6:
                    ip_a, _, flags, mac_a, _, dev = parts[:6]
                    if dev == iface and ip_a in gw_ips and flags != "0x0" and mac_a != "00:00:00:00:00:00":
                        gw_macs.add(mac_a.lower())
    except Exception:
        pass
    return gw_macs


