def main() -> int:
    args = sys.argv[1:]
    if not args:
        return run_discovery(fast_mode=False)

    cmd = args[0].lower()
    if cmd in ("-h", "--help", "help"):
        print_help()
        return 0
    elif cmd == "gui":
        print(f"{C.CYAN}{C.BOLD}[PROCAM RADAR GUI]{C.RESET} Запуск графического приложения ProCam Radar...")
        ok = run_gui_as_sudo_user(["/usr/local/bin/yeee-gui"])
        return 0 if ok else 1
    elif cmd in ("scan", "fast"):
        return run_radar_scan()
    elif cmd == "clean":
        return clean_yeee_subnets()
    elif cmd == "conflict":
        return run_conflict_scan()
    elif cmd == "pdf":
        return run_dump_report(fmt="pdf")
    elif cmd in ("manual", "man", "doc"):
        return run_manual_command()
    elif cmd == "dump":
        if len(args) >= 2 and args[1].lower() in ("pdf", "md"):
            return run_dump_report(fmt=args[1].lower())
        return run_dump_report(fmt="both")
    elif cmd == "info":
        if len(args) < 2:
            print(f"{C.RED}[ОШИБКА] Укажите IP-адрес: yeee info <IP>{C.RESET}")
            return 1
        return run_info_camera(args[1])
    elif cmd == "free":
        cnt = int(args[1]) if (len(args) >= 2 and args[1].isdigit()) else 10
        sub_arg = args[2] if len(args) >= 3 else None
        return run_free_ips(cnt, sub_arg)
    elif cmd == "play":
        if len(args) < 2:
            print(f"{C.RED}[ОШИБКА] Синтаксис: yeee play <IP> [USER] [PASS] [--sub]{C.RESET}")
            return 1
        sub_s = "--sub" in args
        clean_a = [a for a in args[1:] if a != "--sub"]
        u_a = clean_a[1] if len(clean_a) >= 3 else None
        p_a = clean_a[2] if len(clean_a) >= 3 else None
        return run_play_camera(clean_a[0], u_a, p_a, sub_stream=sub_s)
    elif cmd == "snap":
        if len(args) < 2:
            print(f"{C.RED}[ОШИБКА] Синтаксис: yeee snap <IP> [USER] [PASS]{C.RESET}")
            return 1
        u_a = args[2] if len(args) >= 4 else None
        p_a = args[3] if len(args) >= 4 else None
        return run_snap_camera(args[1], u_a, p_a)
    elif cmd == "activate":
        if len(args) < 2:
            print(f"{C.RED}[ОШИБКА] Синтаксис: yeee activate <NEW_PASS> [START_IP]{C.RESET}")
            return 1
        s_ip = args[2] if len(args) >= 3 else None
        return run_activate_cameras(args[1], s_ip)
    elif cmd == "watch":
        return run_watch_mode()
    elif cmd == "open":
        if len(args) < 2:
            print(f"{C.RED}[ОШИБКА] Укажите IP-адрес камеры: yeee open <IP> [--mac <MAC>]{C.RESET}")
            return 1
        target_mac = None
        if len(args) >= 4 and args[2] == "--mac":
            target_mac = args[3]
        elif len(args) >= 3 and not args[2].startswith("-"):
            target_mac = args[2]
        return run_open_camera(args[1], target_mac=target_mac)
    elif cmd == "cable":
        if len(args) < 2:
            print(f"{C.RED}[ОШИБКА] Укажите IP-адрес для проверки кабеля: yeee cable <IP>{C.RESET}")
            return 1
        return run_cable_diag(args[1])
    elif cmd == "resolve":
        if len(args) < 3:
            print(f"{C.RED}[ОШИБКА] Синтаксис: yeee resolve <CONFLICT_IP> <START_NEW_IP> [USER] [PASS] [GATEWAY]{C.RESET}")
            return 1
        u_arg = args[3] if len(args) >= 5 else None
        p_arg = args[4] if len(args) >= 5 else None
        gw = args[5] if len(args) >= 6 else None
        return run_resolve_conflicts(args[1], args[2], u_arg, p_arg, gw)
    elif cmd == "set-ip":
        raw_sub = args[1:]
        target_mac = None
        filtered = []
        i = 0
        while i < len(raw_sub):
            if raw_sub[i] == "--mac" and i + 1 < len(raw_sub):
                target_mac = raw_sub[i + 1]
                i += 2
            elif raw_sub[i].startswith("--mac="):
                target_mac = raw_sub[i].split("=", 1)[1]
                i += 1
            else:
                filtered.append(raw_sub[i])
                i += 1
        if len(filtered) < 2:
            print(f"{C.RED}[ОШИБКА] Синтаксис: yeee set-ip <OLD_IP> <NEW_IP> [USER] [PASS] [GATEWAY] [--mac <TARGET_MAC>]{C.RESET}")
            return 1
        u_arg = filtered[2] if len(filtered) >= 4 else None
        p_arg = filtered[3] if len(filtered) >= 4 else None
        gw = filtered[4] if len(filtered) >= 5 else None
        return run_set_ip(filtered[0], filtered[1], u_arg, p_arg, gw, target_mac=target_mac)
    else:
        print(f"{C.RED}[ОШИБКА] Неизвестная команда: {args[0]}{C.RESET}\n")
        print_help()
        return 1


if __name__ == "__main__":
    sys.exit(main())
