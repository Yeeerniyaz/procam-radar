# УПРАВЛЕНИЕ ПОЛЬЗОВАТЕЛЬСКИМ КОНТЕКСТОМ ($SUDO_USER) И БЕЗОПАСНЫЙ GUI-ВРАППЕР
# ==============================================================================
def get_sudo_user_info() -> dict:
    """Возвращает информацию о реальном пользователе, вызвавшем утилиту (SUDO_USER)."""
    sudo_user = os.environ.get("SUDO_USER")
    if not sudo_user or sudo_user == "root":
        # Пытаемся определить по владельцу текущего рабочего каталога или UID 1000
        try:
            cwd_stat = os.stat(os.getcwd())
            if cwd_stat.st_uid != 0:
                pw = pwd.getpwuid(cwd_stat.st_uid)
                sudo_user = pw.pw_name
        except Exception:
            pass
    if not sudo_user or sudo_user == "root":
        try:
            pw = pwd.getpwuid(1000)
            sudo_user = pw.pw_name
        except Exception:
            sudo_user = "root"

    try:
        pw = pwd.getpwnam(sudo_user)
        return {
            "user": pw.pw_name,
            "uid": pw.pw_uid,
            "gid": pw.pw_gid,
            "home": pw.pw_dir,
        }
    except KeyError:
        return {"user": "root", "uid": 0, "gid": 0, "home": "/root"}


def chown_to_sudo_user(filepath: str) -> str:
    """Меняет владельца файла с root на $SUDO_USER."""
    uinfo = get_sudo_user_info()
    try:
        os.chown(filepath, uinfo["uid"], uinfo["gid"])
    except Exception:
        pass
    return uinfo["user"]


def run_gui_as_sudo_user(cmd_args: list) -> bool:
    """
    Безопасный враппер запуска GUI-приложений (xdg-open, браузер, плеер) из-под sudo
    от имени обычного пользователя ($SUDO_USER) с сохранением DISPLAY, WAYLAND_DISPLAY и XAUTHORITY.
    """
    uinfo = get_sudo_user_info()
    uid = uinfo["uid"]
    user = uinfo["user"]
    home = uinfo["home"]

    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{uid}"
    display = os.environ.get("DISPLAY") or ":0"
    wayland_display = os.environ.get("WAYLAND_DISPLAY") or ""
    if not wayland_display and os.path.exists(f"{runtime_dir}/wayland-0"):
        wayland_display = "wayland-0"

    xauthority = os.environ.get("XAUTHORITY") or ""
    if not xauthority:
        cand_xauth = os.path.join(home, ".Xauthority")
        if os.path.exists(cand_xauth):
            xauthority = cand_xauth

    dbus_addr = os.environ.get("DBUS_SESSION_BUS_ADDRESS") or ""
    if not dbus_addr and os.path.exists(f"{runtime_dir}/bus"):
        dbus_addr = f"unix:path={runtime_dir}/bus"

    env_kv = [
        f"HOME={home}",
        f"USER={user}",
        f"LOGNAME={user}",
        f"DISPLAY={display}",
        f"XDG_RUNTIME_DIR={runtime_dir}",
        f"PATH={os.environ.get('PATH', '/usr/local/bin:/usr/bin:/bin')}",
    ]
    if wayland_display:
        env_kv.append(f"WAYLAND_DISPLAY={wayland_display}")
    if xauthority:
        env_kv.append(f"XAUTHORITY={xauthority}")
    if dbus_addr:
        env_kv.append(f"DBUS_SESSION_BUS_ADDRESS={dbus_addr}")

    full_cmd = ["sudo", "-u", user, "env"] + env_kv + cmd_args
    try:
        subprocess.Popen(
            full_cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except Exception as exc:
        print(f"{C.RED}[ОШИБКА GUI-ВРАППЕРА] Не удалось запустить {cmd_args}: {exc}{C.RESET}")
        return False


