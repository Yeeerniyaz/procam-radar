# ЭТАП 3: АКТИВНАЯ L2-ПРОВОКАЦИЯ И ГЛУБОКИЙ ПАРСИНГ МЕТАДАННЫХ (SADP / ONVIF / DHIP)
# ==============================================================================
def build_onvif_probe() -> bytes:
    msg_id = f"uuid:{uuid.uuid4()}"
    xml = (
        '<?xml version="1.0" encoding="UTF-8"?>'
        '<e:Envelope xmlns:e="http://www.w3.org/2003/05/soap-envelope" '
        'xmlns:w="http://schemas.xmlsoap.org/ws/2004/08/addressing" '
        'xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery" '
        'xmlns:dn="http://www.onvif.org/ver10/network/wsdl">'
        "<e:Header>"
        f"<w:MessageID>{msg_id}</w:MessageID>"
        '<w:To e:mustUnderstand="true">urn:schemas-xmlsoap-org:ws:2005:04:discovery</w:To>'
        '<w:Action a:mustUnderstand="true" xmlns:a="http://www.w3.org/2005/08/addressing">'
        "http://schemas.xmlsoap.org/ws/2005/04/discovery/Probe</w:Action>"
        "</e:Header>"
        "<e:Body>"
        "<d:Probe><d:Types>dn:NetworkVideoTransmitter</d:Types></d:Probe>"
        "</e:Body>"
        "</e:Envelope>"
    )
    return xml.encode("utf-8")


def build_sadp_probe() -> bytes:
    probe_uuid = str(uuid.uuid4()).upper()
    xml = f'<?xml version="1.0" encoding="utf-8"?><Probe><Uuid>{probe_uuid}</Uuid><Types>inquiry</Types></Probe>'
    return xml.encode("utf-8")


def build_dahua_probe() -> bytes:
    body = b'{"method":"DHDiscover.search","params":{"mac":"","uni":1}}\r\n'
    header = (
        b"\x20\x00\x00\x00" + b"DHIP" + b"\x00" * 12
        + len(body).to_bytes(4, "little")
        + b"\x00" * 4
        + len(body).to_bytes(4, "little")
        + b"\x00" * 4
    )
    return header + body


def send_l2_provocations(iface: str, probe_src_ips: set) -> None:
    """
    Отправляет сырые L2-фреймы через Scapy sendp:
      а) ONVIF WS-Discovery XML Probe на 239.255.255.250:3702
      б) Hikvision SADP XML Probe на 239.255.255.250:37020 и 255.255.255.255:37020
      в) Dahua DHIP Probe и точечные L2 ARP-запросы к заводским IP камер
    """
    if not get_carrier(iface):
        return

    src_mac = get_iface_mac(iface)
    ipv4_list = get_iface_ipv4_list(iface)
    src_ip = ipv4_list[0]["ip"] if ipv4_list else "192.168.1.250"
    probe_src_ips.add(src_ip)

    onvif_payload = build_onvif_probe()
    sadp_payload = build_sadp_probe()
    dahua_payload = build_dahua_probe()

    frames = [
        # a) ONVIF WS-Discovery XML Probe -> 239.255.255.250:3702 (Multicast + Broadcast)
        Ether(src=src_mac, dst="01:00:5e:7f:ff:fa")
        / IP(src=src_ip, dst="239.255.255.250", ttl=4)
        / UDP(sport=3702, dport=3702)
        / Raw(load=onvif_payload),
        Ether(src=src_mac, dst="ff:ff:ff:ff:ff:ff")
        / IP(src=src_ip, dst="239.255.255.250", ttl=4)
        / UDP(sport=3702, dport=3702)
        / Raw(load=onvif_payload),

        # б) Hikvision SADP XML Probe -> 239.255.255.250:37020 и 255.255.255.255:37020
        Ether(src=src_mac, dst="01:00:5e:7f:ff:fa")
        / IP(src=src_ip, dst="239.255.255.250", ttl=4)
        / UDP(sport=37020, dport=37020)
        / Raw(load=sadp_payload),
        Ether(src=src_mac, dst="ff:ff:ff:ff:ff:ff")
        / IP(src=src_ip, dst="255.255.255.255", ttl=4)
        / UDP(sport=37020, dport=37020)
        / Raw(load=sadp_payload),

        # в) Dahua ConfigTool Discovery -> 239.255.255.251:37810 и 255.255.255.255:37810
        Ether(src=src_mac, dst="01:00:5e:7f:ff:fb")
        / IP(src=src_ip, dst="239.255.255.251", ttl=4)
        / UDP(sport=37810, dport=37810)
        / Raw(load=dahua_payload),
        Ether(src=src_mac, dst="ff:ff:ff:ff:ff:ff")
        / IP(src=src_ip, dst="255.255.255.255", ttl=4)
        / UDP(sport=37810, dport=37810)
        / Raw(load=dahua_payload),
    ]

    default_camera_targets = [
        ("192.168.1.250", "192.168.1.64"),
        ("192.168.1.250", "192.168.1.108"),
        ("192.168.1.250", "192.168.1.100"),
        ("192.168.1.250", "192.168.1.2"),
        ("192.168.1.250", "192.168.1.10"),
        ("192.168.0.250", "192.168.0.64"),
        ("192.168.0.250", "192.168.0.108"),
        ("192.168.0.250", "192.168.0.120"),
    ]
    for p_src, p_dst in default_camera_targets:
        probe_src_ips.add(p_src)
        frames.append(
            Ether(src=src_mac, dst="ff:ff:ff:ff:ff:ff")
            / ARP(op=1, hwsrc=src_mac, psrc=p_src, hwdst="00:00:00:00:00:00", pdst=p_dst)
        )

    try:
        sendp(frames, iface=iface, verbose=False)
    except Exception:
        pass


def parse_xml_discovery_payload(raw_bytes: bytes) -> dict:
    """
    Глубокий парсер L2 UDP-ответов (agent_04_diag):
      - Hikvision SADP (порт 37020): IPv4Address, DeviceDescription/DeviceType, DeviceSN, SoftwareVersion/DSPVersion
      - ONVIF WS-Discovery (порт 3702): XAddrs, Types, Scopes (hardware/model/name, serial, firmware/version)
      - Dahua DHIP (порт 37810): IPAddress, DeviceType/MachineName, SerialNo, Version
    """
    info = {}
    try:
        text = raw_bytes.decode("utf-8", errors="ignore")
    except Exception:
        return info

    # 1. Hikvision SADP XML
    m_sadp_ip = re.search(r"<IPv4Address>\s*(\d+\.\d+\.\d+\.\d+)\s*</IPv4Address>", text, re.I)
    if m_sadp_ip:
        info["ip"] = m_sadp_ip.group(1)
        info["vendor"] = "Hikvision / HiWatch (SADP)"

    m_sadp_desc = re.search(r"<DeviceDescription>\s*([^<]+)\s*</DeviceDescription>", text, re.I)
    m_sadp_type = re.search(r"<DeviceType>\s*([^<]+)\s*</DeviceType>", text, re.I)
    if m_sadp_desc:
        info["model"] = m_sadp_desc.group(1).strip()
    elif m_sadp_type:
        info["model"] = m_sadp_type.group(1).strip()

    m_sadp_sn = re.search(r"<(?:DeviceSN|SerialNumber)>\s*([^<]+)\s*</(?:DeviceSN|SerialNumber)>", text, re.I)
    if m_sadp_sn:
        info["serial"] = m_sadp_sn.group(1).strip()

    m_sadp_fw = re.search(r"<SoftwareVersion>\s*([^<]+)\s*</SoftwareVersion>", text, re.I)
    m_sadp_dsp = re.search(r"<DSPVersion>\s*([^<]+)\s*</DSPVersion>", text, re.I)
    if m_sadp_fw:
        fw_str = m_sadp_fw.group(1).strip()
        if m_sadp_dsp:
            fw_str += f" (DSP: {m_sadp_dsp.group(1).strip()})"
        info["firmware"] = fw_str

    # 2. ONVIF WS-Discovery SOAP/XML
    if "ProbeMatches" in text or "XAddrs" in text or "Scopes" in text:
        m_onvif_ip = re.search(r"https?://(\d+\.\d+\.\d+\.\d+)", text, re.I)
        if m_onvif_ip and "ip" not in info:
            info["ip"] = m_onvif_ip.group(1)

        m_types = re.search(r"<(?:\w+:)?Types>\s*([^<]+)\s*</(?:\w+:)?Types>", text, re.I)
        types_val = m_types.group(1).strip() if m_types else ""

        m_scopes = re.search(r"<(?:\w+:)?Scopes>\s*([^<]+)\s*</(?:\w+:)?Scopes>", text, re.I)
        if m_scopes:
            scopes_raw = urllib.parse.unquote(m_scopes.group(1).strip())
            m_hw = re.search(r"onvif://www\.onvif\.org/(?:hardware|Model)/([^\s]+)", scopes_raw, re.I)
            m_name = re.search(r"onvif://www\.onvif\.org/name/([^\s]+)", scopes_raw, re.I)
            if m_hw and "model" not in info:
                info["model"] = m_hw.group(1).strip()
            elif m_name and "model" not in info:
                info["model"] = m_name.group(1).strip()

            m_sn = re.search(r"onvif://www\.onvif\.org/(?:serial|serialnumber)/([^\s]+)", scopes_raw, re.I)
            if m_sn and "serial" not in info:
                info["serial"] = m_sn.group(1).strip()

            m_fw = re.search(r"onvif://www\.onvif\.org/(?:firmware|version|software)/([^\s]+)", scopes_raw, re.I)
            if m_fw and "firmware" not in info:
                info["firmware"] = m_fw.group(1).strip()

        if "model" not in info and types_val:
            info["model"] = types_val

        if "vendor" not in info:
            low = text.lower()
            if "hikvision" in low or "hiwatch" in low:
                info["vendor"] = "Hikvision / HiWatch (ONVIF)"
            elif "dahua" in low or "imou" in low:
                info["vendor"] = "Dahua (ONVIF)"
            elif "tiandy" in low:
                info["vendor"] = "Tiandy (ONVIF)"
            elif "uniview" in low or "unv" in low:
                info["vendor"] = "Uniview (ONVIF)"
            else:
                info["vendor"] = "ONVIF IP Camera"

    # 3. Dahua DHIP JSON
    if "DHDiscover" in text or '"DeviceType"' in text or '"SerialNo"' in text:
        m_dh_ip = re.search(r'"IPv4Address"\s*:\s*\{[^}]*"IPAddress"\s*:\s*"(\d+\.\d+\.\d+\.\d+)"', text)
        if m_dh_ip and "ip" not in info:
            info["ip"] = m_dh_ip.group(1)
        m_dh_model = re.search(r'"DeviceType"\s*:\s*"([^"]+)"', text)
        if m_dh_model and "model" not in info:
            info["model"] = m_dh_model.group(1).strip()
        m_dh_sn = re.search(r'"SerialNo"\s*:\s*"([^"]+)"', text)
        if m_dh_sn and "serial" not in info:
            info["serial"] = m_dh_sn.group(1).strip()
        m_dh_fw = re.search(r'"Version"\s*:\s*"([^"]+)"', text)
        if m_dh_fw and "firmware" not in info:
            info["firmware"] = m_dh_fw.group(1).strip()
        if "vendor" not in info:
            info["vendor"] = "Dahua (DHIP)"

    return info


