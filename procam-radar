# ЭТАП 5: ПРОВЕРКА ПОРТОВ, ВЫДАЧА КАРТОЧКИ И КЭШИРОВАНИЕ ДЛЯ DUMP
# ==============================================================================
TARGET_PORTS = [80, 443, 8000, 554, 37777]


def check_single_port(ip: str, port: int, timeout: float = 0.8) -> bool:
    try:
        with socket.create_connection((ip, port), timeout=timeout):
            return True
    except Exception:
        return False


def scan_camera_ports(ip: str) -> list:
    if not ip or ip == "0.0.0.0":
        return []
    open_ports = []
    with ThreadPoolExecutor(max_workers=len(TARGET_PORTS)) as executor:
        futures = {port: executor.submit(check_single_port, ip, port) for port in TARGET_PORTS}
        for port in TARGET_PORTS:
            if futures[port].result():
                open_ports.append(port)
    return open_ports


def build_rtsp_link(ip: str, vendor: str, open_ports: list) -> str:
    v_low = (vendor or "").lower()
    if "hikvision" in v_low or "hiwatch" in v_low or 8000 in open_ports:
        return f"rtsp://admin:password@{ip}:554/Streaming/Channels/101"
    if "dahua" in v_low or 37777 in open_ports:
        return f"rtsp://admin:password@{ip}:554/cam/realmonitor?channel=1&subtype=0"
    if "tiandy" in v_low:
        return f"rtsp://admin:password@{ip}:554/1/1"
    return f"rtsp://admin:password@{ip}:554/stream1"


def enrich_camera_record(cam: dict) -> dict:
    """Формирует финальные поля карточки (бренд, ссылки, метаданные) для вывода и сохранения в dump."""
    ip = cam.get("ip", "0.0.0.0")
    mac = cam.get("mac", "00:00:00:00:00:00").upper()
    vendor = cam.get("vendor") or get_camera_vendor(cam.get("mac", "")) or "Неизвестный бренд (New Node)"
    open_ports = cam.get("open_ports", [])

