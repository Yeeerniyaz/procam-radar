def run_watch_mode() -> int:
    """Режим «Монтажник на стремянке»: непрерывный мониторинг со звуковым оповещением и авто-проверкой кабеля."""
    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}  YEEE WATCH — Режим «Монтажник на стремянке» (Аудио-маяк + Авто-тест){C.RESET}")
    print(f"{C.CYAN}{C.BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{C.RESET}")

    try:
        iface, _, wired_ifaces, _ = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    local_macs, local_ips = get_all_local_macs_and_ips()
    baseline_macs, baseline_ips = calibrate_baseline(iface, local_macs, local_ips)
    seen_macs = set(baseline_macs)
    probe_src_ips = set(local_ips)

    print(f"\n{C.GREEN}{C.BOLD}[МОНИТОРИНГ АКТИВЕН]{C.RESET} Подключайте камеры к свитчу/ноутбуку. Нажмите {C.BOLD}Ctrl+C{C.RESET} для выхода.\n")

    def watch_pkt_handler(pkt):
        if not pkt.haslayer(Ether):
            return
        s_mac = pkt[Ether].src.lower()
        if s_mac in seen_macs or s_mac == "ff:ff:ff:ff:ff:ff":
            return

        ip_cand = None
        if pkt.haslayer(ARP) and pkt[ARP].psrc != "0.0.0.0":
            ip_cand = pkt[ARP].psrc
        elif pkt.haslayer(IP) and pkt[IP].src not in ("0.0.0.0", "255.255.255.255"):
            ip_cand = pkt[IP].src

        if not ip_cand or ip_cand in probe_src_ips:
            return

        seen_macs.add(s_mac)
        emit_sound_beep()
        ts = datetime.now().strftime("%H:%M:%S")
        vendor = get_camera_vendor(s_mac) or "Новое устройство"
        sub_info = inject_subnet_alias(iface, ip_cand)
        res_mtu = run_cmd(["ping", "-c", "10", "-i", "0.02", "-s", "1472", "-W", "1", ip_cand])
        mtu_stats = parse_ping_output(res_mtu.stdout)
        cable_str = (
            f"{C.GREEN}КАБЕЛЬ OK (1472B loss 0%){C.RESET}"
            if mtu_stats["loss"] == 0.0
            else f"{C.RED}ПОТЕРИ MTU 1472B: {mtu_stats['loss']:.0f}%{C.RESET}"
        )
        print(
            f"  🔔 [{ts}] {C.GREEN}{C.BOLD}НОВАЯ ТОЧКА!{C.RESET} IP={C.CYAN}{C.BOLD}{ip_cand}{C.RESET} | "
            f"MAC={C.YELLOW}{s_mac.upper()}{C.RESET} ({C.MAGENTA}{vendor}{C.RESET}) | {cable_str} | {sub_info.get('status')}"
        )

    try:
        while True:
            send_l2_provocations(iface, probe_src_ips)
            sniff(iface=iface, timeout=2.5, store=False, prn=watch_pkt_handler)
    except KeyboardInterrupt:
        print(f"\n{C.YELLOW}[ВЫХОД]{C.RESET} Мониторинг `yeee watch` завершен.")
    return 0


