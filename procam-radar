def parse_ping_output(stdout_text: str) -> dict:
    """Извлекает процент потерь (loss) и статистику RTT (min, avg, max, mdev) из вывода ping."""
    result = {
        "loss": 100.0,
        "min": 0.0,
        "avg": 0.0,
        "max": 0.0,
        "mdev": 0.0,
        "received": 0,
    }
    m_loss = re.search(r"(\d+(?:\.\d+)?)%\s*packet loss", stdout_text)
    if not m_loss:
        m_loss = re.search(r"(\d+(?:\.\d+)?)%\s*потерь", stdout_text)
    if m_loss:
        result["loss"] = float(m_loss.group(1))

    m_rcv = re.search(r"(\d+)\s+received", stdout_text)
    if m_rcv:
        result["received"] = int(m_rcv.group(1))

    m_rtt = re.search(r"=\s*([\d.]+)/([\d.]+)/([\d.]+)/([\d.]+)\s*ms", stdout_text)
    if m_rtt:
        result["min"] = float(m_rtt.group(1))
        result["avg"] = float(m_rtt.group(2))
        result["max"] = float(m_rtt.group(3))
        result["mdev"] = float(m_rtt.group(4))
    return result


def run_cable_diag(target_ip: str) -> int:
    try:
        ipaddress.IPv4Address(target_ip)
    except ValueError:
        print(f"{C.RED}[ОШИБКА] Некорректный IPv4-адрес: {target_ip}{C.RESET}")
