    cam["vendor_resolved"] = vendor
    cam["model"] = cam.get("model") or "Н/Д (не передано в L2)"
    cam["serial"] = cam.get("serial") or "Н/Д"
    cam["firmware"] = cam.get("firmware") or "Н/Д"
    cam["web_link"] = web_link
    cam["rtsp_link"] = rtsp_link
    return cam


