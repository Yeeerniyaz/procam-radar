def run_open_camera(target_ip: str, target_mac: str = None) -> int:
    try:
        ipaddress.IPv4Address(target_ip)
    except ValueError:
        print(f"{C.RED}[ОШИБКА] Некорректный IPv4-адрес: {target_ip}{C.RESET}")
        return 1

    norm_mac = None
    if target_mac:
        norm_mac = normalize_mac(target_mac)
        if not norm_mac:
            print(f"{C.RED}[ОШИБКА] Некорректный формат MAC-адреса: {target_mac} (ожидается XX:XX:XX:XX:XX:XX){C.RESET}")
            return 1

    print(f"{C.CYAN}{C.BOLD}[YEEE OPEN]{C.RESET} Подготовка подключения к камере {C.BOLD}{target_ip}{C.RESET} (пароль не требуется)...")
    try:
        iface, _, _, _ = discover_interfaces()
    except RuntimeError as exc:
        print(f"{C.RED}[ОШИБКА] {exc}{C.RESET}")
        return 1

    sub_res = inject_subnet_alias(iface, target_ip)
    print(f"  {C.GREEN}✔ Интерфейс:{C.RESET} {iface} | {sub_res.get('status')}")

    if norm_mac:
        pin_res = run_cmd(["ip", "neigh", "replace", target_ip, "lladdr", norm_mac, "nud", "permanent", "dev", iface])
        if pin_res.returncode == 0:
            print(
                f"  {C.MAGENTA}🔒 [L2 ИЗОЛЯЦИЯ БЕЗ ПАРОЛЯ]{C.RESET} Весь трафик к {C.BOLD}{target_ip}{C.RESET} жестко привязан к MAC "
                f"{C.YELLOW}{C.BOLD}{norm_mac.upper()}{C.RESET}!\n"
                f"     Вторая конфликтующая камера на этом же IP полностью игнорируется ядром Linux.\n"
                f"     Теперь вы можете активировать эту камеру или задать ей IP прямо в браузере."
            )

    has_80 = check_single_port(target_ip, 80, timeout=0.6)
    has_443 = check_single_port(target_ip, 443, timeout=0.6)
    url = f"https://{target_ip}" if (has_443 and not has_80) else f"http://{target_ip}"

    uinfo = get_sudo_user_info()
    print(f"  {C.BLUE}➔ Открытие {C.BOLD}{url}{C.RESET}{C.BLUE} в браузере пользователя {C.BOLD}{uinfo['user']}{C.RESET}...")
    ok = run_gui_as_sudo_user(["xdg-open", url])
    return 0 if ok else 1


