# КОМАНДА CLEAN: ОЧИСТКА ВРЕМЕННЫХ ПОДСЕТЕЙ (*:yeee) И ТОЧЕЧНЫХ МАРШРУТОВ
# ==============================================================================
def clean_yeee_subnets() -> int:
    print(f"{C.CYAN}{C.BOLD}[PROCAM RADAR · ОЧИСТКА СЕТЕЙ]{C.RESET} Поиск и удаление временных подсетей (label *:yeee)...")
    res = run_cmd(["ip", "-j", "-4", "addr", "show"])
    if res.returncode != 0:
        print(f"{C.RED}[ОШИБКА] Не удалось получить список IP-адресов.{C.RESET}")
        return 1

    removed = []
    alias_ips = set()
    try:
        data = json.loads(res.stdout)
    except Exception:
        data = []

    for iface_obj in data:
        iface = iface_obj.get("ifname", "")
        for info in iface_obj.get("addr_info", []):
            label = info.get("label", "")
            if label.endswith(":yeee"):
                local_ip = info["local"]
                alias_ips.add(local_ip)
                cidr = f"{local_ip}/{info['prefixlen']}"
                del_res = run_cmd(["ip", "addr", "del", cidr, "dev", iface])
                if del_res.returncode == 0:
                    removed.append((iface, cidr, label))
                    print(f"  {C.GREEN}✔ Удален алиас:{C.RESET} {C.BOLD}{cidr}{C.RESET} на {iface} ({label})")
                else:
                    print(f"  {C.RED}✖ Ошибка удаления {cidr} на {iface}: {del_res.stderr.strip()}{C.RESET}")

    # Очищаем точечные /32 маршруты, созданные при совпадении подсети Wi-Fi и Ethernet
    route_res = run_cmd(["ip", "-j", "-4", "route", "show"])
    if route_res.returncode == 0 and route_res.stdout.strip():
        try:
            routes = json.loads(route_res.stdout)
            for r in routes:
                prefsrc = r.get("prefsrc", "")
                dst = r.get("dst", "")
                dev = r.get("dev", "")
                if prefsrc in alias_ips and dst and dst != "default":
                    run_cmd(["ip", "route", "del", dst, "dev", dev])
        except Exception:
            pass

    if not removed:
        print(f"  {C.GREEN}✔ Активных временных подсетей (*:yeee) не обнаружено. Основная сеть Wi-Fi/роутера в порядке.{C.RESET}")
    else:
        print(f"{C.GREEN}{C.BOLD}[ГОТОВО]{C.RESET} Удалено временных подсетей: {len(removed)}. Интернет и связь с роутером сохранены.")
    return 0


# ==============================================================================
# ЭТАП 1: КАЛИБРОВКА СЕТИ РОУТЕРА (BASELINE)
# ==============================================================================
def calibrate_baseline(iface: str, local_macs: set, local_ips: set) -> tuple:
    """
    Читает /proc/net/arp и слушает эфир 2 секунды.
    Собирает baseline_macs и baseline_ips, ИСКЛЮЧАЯ из игнора MAC-префиксы камер.
    """
    print(f"\n{C.BLUE}{C.BOLD}[ЭТАП 1/5] Калибровка сети (Baseline) на интерфейсе {iface}...{C.RESET}")
    baseline_macs = set(local_macs)
    baseline_ips = set(local_ips)
    skipped_cameras = []

    iface_nets = []
    for item in get_iface_ipv4_list(iface):
        if not item["label"].endswith(":yeee"):
            try:
                iface_nets.append(ipaddress.IPv4Network(f"{item['ip']}/{item['prefix']}", strict=False))
            except ValueError:
                pass

    def is_in_local_subnet(ip_str: str) -> bool:
        if not iface_nets:
            return False
        try:
            ip_obj = ipaddress.IPv4Address(ip_str)
            return any(ip_obj in net for net in iface_nets)
        except ValueError:
            return False

    # 1. Читаем /proc/net/arp
    try:
        with open("/proc/net/arp", "r") as f:
            lines = f.read().splitlines()[1:]
        for line in lines:
            parts = line.split()
            if len(parts) >= 6:
                ip_addr, hw_type, flags, mac_addr, mask, dev = parts[:6]
                mac_addr = mac_addr.lower()
                if mac_addr == "00:00:00:00:00:00" or flags == "0x0":
                    continue
                if is_camera_mac(mac_addr):
                    skipped_cameras.append((ip_addr, mac_addr, get_camera_vendor(mac_addr)))
                    continue
                if is_in_local_subnet(ip_addr):
                    baseline_macs.add(mac_addr)
                    baseline_ips.add(ip_addr)
    except Exception as exc:
        print(f"  {C.YELLOW}[!] Предупреждение при чтении /proc/net/arp: {exc}{C.RESET}")

    # 2. Слушаем эфир 2 секунды для фиксации активных узлов роутера
    print(f"  {C.DIM}Прослушивание эфира (2 сек) для фиксации фоновых устройств роутера...{C.RESET}")

    def _baseline_pkt_handler(pkt):
        if not pkt.haslayer(Ether):
            return
        src_mac = pkt[Ether].src.lower()
        if src_mac in local_macs or src_mac == "ff:ff:ff:ff:ff:ff":
            return
        if is_camera_mac(src_mac):
            return
        src_ip = None
        if pkt.haslayer(ARP):
            src_ip = pkt[ARP].psrc
        elif pkt.haslayer(IP):
            src_ip = pkt[IP].src

        if src_ip and src_ip not in ("0.0.0.0", "255.255.255.255") and is_in_local_subnet(src_ip):
            baseline_macs.add(src_mac)
            baseline_ips.add(src_ip)

    try:
        sniff(iface=iface, timeout=2.0, store=False, prn=_baseline_pkt_handler)
    except Exception:
        pass

    ignored_count = max(0, len(baseline_macs) - len(local_macs))
    print(f"  {C.GREEN}✔ В baseline_ignore добавлено фоновых узлов сети:{C.RESET} {ignored_count}")
    if skipped_cameras:
        for c_ip, c_mac, c_vendor in skipped_cameras:
            print(f"  {C.YELLOW}★ Камера в ARP исключена из игнора:{C.RESET} {c_ip} ({c_mac} — {c_vendor})")

    return baseline_macs, baseline_ips


