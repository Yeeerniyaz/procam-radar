{
  "name": "procam-radar-desktop",
  "private": true,
  "version": "5.0.0",
  "description": "ProCam Radar — Native Cross-Platform IP Camera Discovery, Network Bridge & Cable Diagnostics Suite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build",
    "build": "tsc --noEmit -p tsconfig.json && vite build && bash scripts/build-native.sh"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
